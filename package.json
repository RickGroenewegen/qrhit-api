{
  "name": "qrhit-api",
  "version": "1.0.28",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf ./.build-temp && npx prisma generate && NODE_OPTIONS=--max-old-space-size=4096 tsc --outDir ./.build-temp --incremental --skipDefaultLibCheck --strictFunctionTypes && ncp ./src ./.build-temp && rm -rf ./build && mv ./.build-temp ./build",
    "start:dev": "tsc -w & nodemon --watch build --ext js --exec 'node -r dotenv/config --no-deprecation build/src/app.js' --exitcrash",
    "start:dev2": "tsx watch src/app.ts",
    "start:dev-with-workers": "RUN_QUEUE_WORKERS=true npm run start:dev",
    "start": "npm run build && ncp ./src ./build && node -r dotenv/config build/src/app.js",
    "start:worker": "npm run build && ncp ./src ./build && node -r dotenv/config build/src/worker.js",
    "start:worker-dev": "tsx watch src/worker.ts",
    "start_pm2": "git reset --hard HEAD && git pull origin HEAD && sudo npm install --force && sudo npx prisma db push && npm run build && ncp ./src ./build && node -r dotenv/config build/src/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:int": "vitest run test/integration test/ws",
    "test:coverage": "vitest run --coverage",
    "test:db:push": "node test/db-push.js",
    "test:live": "vitest run --config vitest.live.config.ts",
    "kpi": "tsx scripts/kpi.ts"
  },
