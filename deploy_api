#!/bin/bash

# Navigate to the Git repository directory
# Replace '/path/to/your/repo' with the actual path to your Git repository
cd /home/ec2-user/sites/qrsong

# Reset the repository to HEAD
git reset --hard HEAD
# 43d01d2e980787e984931296caf0c127e79fef60
# pm2 start npm --name "qrsong" -- run start
# pm2 start dist/qrhit/server/server.mjs --name "qrsong-frontend"

# Pull the latest changes from the remote repository
git pull origin HEAD

sudo chmod +x deploy
sudo chmod +x deploy_api
sudo chmod +x deploy_frontend

sudo npm install --force
sudo prisma db push
echo "Repository has been reset and updated."

# Build while the old process is still serving. `npm run start` (what pm2
# runs) sees that ./build matches this commit and starts straight away, so the
# API is only down for its own boot. A failed build stops here: the old
# process keeps running on the old build.
if ! npm run build; then
  echo "Build failed, NOT restarting: the API is still running the previous build."
  exit 1
fi

pm2 restart qrsong

pm2 logs qrsong --lines 1000
