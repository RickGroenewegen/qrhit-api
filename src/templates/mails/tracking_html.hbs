{{#> mail-layout title=mail.trackingMailSubject preheader=mail.trackingMailSubject }}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.orderShipped }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=trackingLink label=translations.trackOrder }}</td>
    </tr>
</table>
{{#if showAppDesign}}
{{#unless appDesignEntitled}}
<p style="margin: 0 0 20px; font-size: 15px; line-height: 24px; color: #18565e;">{{ translations.appDesignTrackingLine }} <a href="{{ appDesignUrl }}" style="color: #18565e; font-weight: 700;">{{ translations.appDesignTrackingLink }}</a></p>
{{/unless}}
{{/if}}
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thankYou }}</p>
{{> mail-closing }}
{{/mail-layout}}
