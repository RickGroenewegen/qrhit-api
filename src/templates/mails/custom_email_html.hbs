{{#> mail-layout title=productName }}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; font-weight: 700; color: #0b2c31;">{{ greeting }} {{ fullname }},</p>
<div style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{{ message }}}</div>
{{#if correctionLinks.length}}
{{#each correctionLinks}}
<p style="margin: 0 0 12px; font-size: 16px; line-height: 26px; font-weight: 700; color: #0b2c31; text-align: center;">{{ this.name }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=this.link label=../correctionTranslations.buttonText }}</td>
    </tr>
</table>
{{/each}}
<p style="margin: 0 0 8px; font-size: 14px; line-height: 22px; color: #3d6d74;">{{ correctionTranslations.buttonFallback }}</p>
{{#each correctionLinks}}
<p style="margin: 0 0 20px; font-size: 13px; line-height: 20px; color: #3d6d74; word-break: break-all;"><a href="{{ this.link }}" style="color: #18565e; text-decoration: underline;">{{ this.link }}</a></p>
{{/each}}
{{/if}}
{{#if messageAfter}}
<div style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{{ messageAfter }}}</div>
{{/if}}
<p style="margin: 28px 0 0; font-size: 16px; line-height: 26px; color: #18565e;">
    <strong style="color: #0b2c31;">{{ productName }}</strong>
</p>
{{/mail-layout}}
