{{#> mail-layout title=(concat productName " - " translations.title) preheader=translations.title }}
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.hello }} {{ fullname }},</p>
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.intro }}</p>
<p style="margin: 0 0 24px; font-size: 16px; line-height: 26px; color: #18565e;">{{ reasonText }}</p>
{{#if flaggedImages}}
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ flaggedImagesIntro }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 24px;">
    {{#each flaggedImages}}
    <tr>
        <td style="padding: 0 0 16px;">
            <p style="margin: 0 0 8px; font-size: 14px; line-height: 20px; font-weight: 700; color: #0b2c31;">{{ this.name }}</p>
            <img src="cid:{{ this.cid }}" alt="{{ this.name }}" style="display: block; max-width: 100%; height: auto; border: 2px solid #18565e; border-radius: 12px;">
        </td>
    </tr>
    {{/each}}
</table>
{{/if}}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.clickButton }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=designerLink label=translations.buttonText }}</td>
    </tr>
</table>
<p style="margin: 0 0 8px; font-size: 14px; line-height: 22px; color: #3d6d74;">{{ translations.buttonFallback }}</p>
<p style="margin: 0 0 20px; font-size: 13px; line-height: 20px; color: #3d6d74; word-break: break-all;"><a href="{{ designerLink }}" style="color: #18565e; text-decoration: underline;">{{ designerLink }}</a></p>
<p style="margin: 0 0 12px; font-size: 14px; line-height: 22px; color: #3d6d74;">{{ translations.afterEdit }}</p>
<p style="margin: 0 0 24px; font-size: 14px; line-height: 22px; color: #3d6d74;">{{ translations.questions }}</p>
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thanks }},<br><strong style="color: #0b2c31;">{{ translations.team }}</strong></p>
{{/mail-layout}}
