{{#> mail-layout title=translations.upgradeInvoiceTitle preheader=translations.upgradeInvoiceBody }}
<p class="qr-text" style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ fullname }},</p>
<p class="qr-text" style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.upgradeInvoiceBody }}</p>
{{#> mail-table }}
    {{> mail-th label=translations.upgradeInvoiceTitle first=true }}
    {{> mail-tr label=translations.upgradeInvoiceNumber value=invoiceNumber }}
    {{> mail-tr label=translations.upgradeInvoicePurchase value=purchase }}
    {{> mail-tr label=translations.upgradeInvoiceDate value=date }}
    {{> mail-total label=translations.upgradeInvoiceAmount value=amountFormatted }}
{{/mail-table}}
<p class="qr-text" style="margin: 20px 0 0; font-size: 14px; line-height: 22px; color: #18565e;">{{ translations.upgradeInvoiceAttached }}</p>
{{> mail-closing }}
{{/mail-layout}}
