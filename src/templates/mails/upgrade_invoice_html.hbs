{{#> mail-layout title=translations.upgradeInvoiceTitle preheader=translations.upgradeInvoiceBody }}
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ fullname }},</p>
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.upgradeInvoiceBody }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin: 8px 0 0;">
    {{> mail-th label=translations.upgradeInvoiceTitle }}
    {{> mail-tr label=translations.upgradeInvoiceNumber value=invoiceNumber }}
    {{> mail-tr label=translations.upgradeInvoicePurchase value=purchase }}
    {{> mail-tr label=translations.upgradeInvoiceDate value=date }}
    <tr>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; background-color: #feefe5; font-weight: 700; font-size: 14px; line-height: 20px; color: #0b2c31; width: 40%;">{{ translations.upgradeInvoiceAmount }}</td>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; font-size: 15px; line-height: 20px; font-weight: 700; color: #0b2c31;">{{ amountFormatted }}</td>
    </tr>
</table>
<p style="margin: 20px 0 0; font-size: 14px; line-height: 22px; color: #18565e;">{{ translations.upgradeInvoiceAttached }}</p>
{{> mail-closing }}
{{/mail-layout}}
