{{#> mail-layout title=(concat productName " - Activation Code") preheader=translations.greatNews rights=translations.allRightsReserved links=true }}
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.greeting }} {{ fullname }},</p>
<p style="margin: 0 0 24px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.greatNews }}</p>
{{> mail-code eyebrow=translations.yourActivationCode code=activationCode note=translations.codeExpires }}
<p style="margin: 0 0 24px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.simpleInstructions }}</p>
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.onceActivated }}</p>
<p style="margin: 0 0 16px; font-size: 14px; line-height: 22px; color: #3d6d74;">{{ translations.needHelp }}</p>
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">
    {{ translations.happyPlaying }}<br>
    <strong style="color: #0b2c31;">{{ translations.team }}</strong>
</p>
{{/mail-layout}}
