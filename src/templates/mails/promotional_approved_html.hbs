{{#> mail-layout title=(concat productName " - " translations.subject) preheader=translations.subject }}
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.hello }} {{ fullname }},</p>
<h1 style="margin: 0 0 12px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 24px; line-height: 30px; letter-spacing: .02em; text-transform: uppercase; color: #0b2c31;">{{ translations.congratulations }}</h1>
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.playlistLive }} <strong style="color: #0b2c31;">"{{ playlistName }}"</strong>!</p>
<p style="margin: 0 0 24px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.earnInfo }}</p>
<!-- Share section -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 24px; border-collapse: separate;">
    <tr>
        <td style="padding: 22px 20px; background-color: #feefe5; border: 2px solid #18565e; border-radius: 16px;">
            <p style="margin: 0 0 8px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 800; font-size: 17px; line-height: 23px; letter-spacing: .02em; text-transform: uppercase; color: #0b2c31;">{{ translations.shareTitle }}</p>
            <p style="margin: 0 0 16px; font-size: 14px; line-height: 22px; color: #18565e;">{{ translations.shareDescription }}</p>
            <p style="margin: 0 0 6px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 800; font-size: 11px; line-height: 16px; letter-spacing: .12em; text-transform: uppercase; color: #3d6d74;">{{ translations.shareLink }}</p>
            <p style="margin: 0 0 18px; padding: 10px 12px; font-size: 14px; line-height: 20px; font-weight: 600; color: #0b2c31; word-break: break-all; background-color: #fff8f3; border: 2px solid #18565e; border-radius: 10px;">
                <a href="{{ shareLink }}" style="color: #0b2c31; text-decoration: none;">{{ shareLink }}</a>
            </p>
            <!-- Social share buttons (each network keeps its own colour) -->
            <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse: separate;">
                <tr>
                    <td style="padding: 0 8px 8px 0;"><a href="{{ whatsappLink }}" target="_blank" style="display: inline-block; padding: 9px 14px; font-size: 12px; line-height: 16px; font-weight: 700; color: #ffffff; background-color: #25d366; border: 2px solid #0b2c31; border-radius: 999px; text-decoration: none;">{{ translations.shareOnWhatsApp }}</a></td>
                    <td style="padding: 0 8px 8px 0;"><a href="{{ facebookLink }}" target="_blank" style="display: inline-block; padding: 9px 14px; font-size: 12px; line-height: 16px; font-weight: 700; color: #ffffff; background-color: #1877f2; border: 2px solid #0b2c31; border-radius: 999px; text-decoration: none;">{{ translations.shareOnFacebook }}</a></td>
                </tr>
                <tr>
                    <td style="padding: 0 8px 0 0;"><a href="{{ instagramLink }}" target="_blank" style="display: inline-block; padding: 9px 14px; font-size: 12px; line-height: 16px; font-weight: 700; color: #ffffff; background-color: #e1306c; border: 2px solid #0b2c31; border-radius: 999px; text-decoration: none;">{{ translations.shareOnInstagram }}</a></td>
                    <td style="padding: 0 8px 0 0;"><a href="{{ twitterLink }}" target="_blank" style="display: inline-block; padding: 9px 14px; font-size: 12px; line-height: 16px; font-weight: 700; color: #ffffff; background-color: #000000; border: 2px solid #0b2c31; border-radius: 999px; text-decoration: none;">{{ translations.shareOnTwitter }}</a></td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<!-- Discount code -->
{{> mail-code eyebrow=translations.yourDiscountCode code=discountCode note=translations.discountCodeHelp }}
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thanks }},<br><strong style="color: #0b2c31;">{{ translations.team }}</strong></p>
{{/mail-layout}}
