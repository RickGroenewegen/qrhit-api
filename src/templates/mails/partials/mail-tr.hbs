<tr>
    <td valign="top" class="qr-tbl-label" style="padding: 10px 8px 10px 16px;{{#unless noLine}} border-top: 1px solid #0b2c31;{{/unless}} font-size: 14px; line-height: 20px; font-weight: 600; color: #18565e; width: 50%;">{{ label }}</td>
    <td valign="top" align="right" class="qr-tbl-value" style="padding: 10px 16px 10px 8px;{{#unless noLine}} border-top: 1px solid #0b2c31;{{/unless}} font-size: 14px; line-height: 20px; font-weight: 700; color: #0b2c31; text-align: right;">{{{ prefix }}}{{ value }}</td>
</tr>
