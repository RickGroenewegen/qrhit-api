<tr>
    <td valign="middle" class="qr-tbl-total" style="padding: 14px 8px 14px 16px; background-color: #18565e; color: #feefe5; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 800; font-size: 13px; line-height: 18px; letter-spacing: .08em; text-transform: uppercase; border-radius: 0 0 0 9px;">{{ label }}</td>
    <td valign="middle" align="right" class="qr-tbl-total qr-tbl-figure" style="padding: 14px 16px 14px 8px; background-color: #18565e; color: #f79677; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 20px; line-height: 24px; text-align: right; white-space: nowrap; border-radius: 0 0 9px 0;">{{ value }}</td>
</tr>
