{{#if hasBingo}}
<!-- Music Bingo section (Disco band) -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin-top: 24px; border-collapse: separate;">
    <tr>
        <td align="center" bgcolor="#18565e" style="padding: 28px 24px; background-color: #18565e; border: 2px solid #0b2c31; border-radius: 20px;">
            <p style="margin: 0 0 8px; font-size: 24px; line-height: 30px;">🎵🎱</p>
            <p style="margin: 0 0 8px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 20px; line-height: 26px; letter-spacing: .02em; text-transform: uppercase; color: #feefe5;">{{ translations.bingoSectionTitle }}</p>
            <p style="margin: 0 0 20px; font-size: 14px; line-height: 22px; color: #feefe5;">{{ translations.bingoSectionDescription }}</p>
            {{> mail-btn-pop href=bingoDownloadUrl label=translations.bingoDownloadButton }}
            <p style="margin: 16px 0 0; font-size: 12px; line-height: 18px; color: #c4d8da;">{{ translations.bingoMoreInfo }}</p>
        </td>
    </tr>
</table>
{{/if}}
