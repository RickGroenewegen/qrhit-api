<table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 auto; border-collapse: separate;">
    <tr>
        <td align="center" bgcolor="#feefe5" style="background-color: #feefe5; border: 2px solid #0b2c31; border-radius: 999px; box-shadow: 4px 4px 0 #0b2c31;">
            <a href="{{ href }}" target="_blank" style="display: inline-block; padding: 13px 28px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 800; font-size: 14px; line-height: 20px; letter-spacing: .06em; text-transform: uppercase; color: #0b2c31; text-decoration: none; border-radius: 999px;">{{{ prefix }}}{{ label }}</a>
        </td>
    </tr>
</table>
