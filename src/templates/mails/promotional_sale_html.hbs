{{#> mail-layout title=(concat productName " - " translations.subject) preheader=translations.subject }}
<p class="qr-text" style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.hello }} {{ fullname }},</p>
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.saleMade }} {{ translations.playlistPurchased }} <strong class="qr-strong" style="color: #0b2c31;">{{ quantity }}x "{{ playlistName }}"</strong>!</p>
<!-- Credit and balance: the sale's credit, then the balance as the total -->
{{#> mail-table margin="0 0 24px" }}
    {{> mail-tr label=translations.credited value=(concat "€" creditedAmount) noLine=true }}
    {{> mail-total label=translations.totalBalance value=(concat "€" totalBalance) }}
{{/mail-table}}
<!-- Discount code -->
{{> mail-code eyebrow=translations.yourDiscountCode code=discountCode compact=true }}
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.keepSharing }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=setupLink label=translations.viewPlaylist }}</td>
    </tr>
</table>
<p class="qr-text" style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thanks }},<br><strong class="qr-strong" style="color: #0b2c31;">{{ translations.team }}</strong></p>
{{/mail-layout}}
