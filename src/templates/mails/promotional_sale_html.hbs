{{#> mail-layout title=(concat productName " - " translations.subject) preheader=translations.subject }}
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.hello }} {{ fullname }},</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.saleMade }} {{ translations.playlistPurchased }} <strong style="color: #0b2c31;">{{ quantity }}x "{{ playlistName }}"</strong>!</p>
<!-- Credit info (Disco band) -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 24px; border-collapse: separate;">
    <tr>
        <td align="center" bgcolor="#18565e" style="padding: 22px 20px; background-color: #18565e; border: 2px solid #0b2c31; border-radius: 16px;">
            <p style="margin: 0 0 6px; font-size: 15px; line-height: 22px; color: #feefe5;">{{ translations.credited }}: <strong style="color: #fbcbb9;">&euro;{{ creditedAmount }}</strong></p>
            <p style="margin: 0; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 20px; line-height: 26px; letter-spacing: .02em; text-transform: uppercase; color: #feefe5;">{{ translations.totalBalance }}: &euro;{{ totalBalance }}</p>
        </td>
    </tr>
</table>
<!-- Discount code -->
{{> mail-code eyebrow=translations.yourDiscountCode code=discountCode compact=true }}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.keepSharing }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=setupLink label=translations.viewPlaylist }}</td>
    </tr>
</table>
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thanks }},<br><strong style="color: #0b2c31;">{{ translations.team }}</strong></p>
{{/mail-layout}}
