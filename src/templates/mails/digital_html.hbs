{{#> mail-layout title=productName preheader=translations.greatNewsDigital }}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.greatNewsDigital }}</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.weHopeYouHaveFunDigital }}</p>
<!-- Download buttons -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 8px;">
    <tr>
        <td align="center" style="padding-bottom: 14px;">{{> mail-btn-pop href=digitalDownloadLink label=translations.downloadButton }}</td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 14px;">{{> mail-btn-outline href=digitalDownloadCorrectionLink label=translations.correctionButton }}</td>
    </tr>
    {{#if sendPhysicalLink}}
    <tr>
        <td align="center" style="padding-bottom: 14px;">{{> mail-btn-disco href=downloadLink label=translations.physicalDownloadButton }}</td>
    </tr>
    {{/if}}
</table>
{{> games-section }}
<!-- Order information -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin: 24px 0 0;">
    {{> mail-th label=translations.orderInformation }}
    {{> mail-tr label=translations.orderNumber value=orderId }}
    {{#each playlists}}
    {{> mail-tr label=../translations.playlist value=this.name }}
    {{/each}}
    <tr>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; background-color: #feefe5; font-weight: 700; font-size: 14px; line-height: 20px; color: #0b2c31; width: 40%;">{{ translations.items }}</td>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; font-size: 14px; line-height: 20px; color: #18565e;">{{ numberOfTracks }} {{ translations.cards }}</td>
    </tr>
    {{> mail-tr label=translations.fullname value=fullname }}
    {{> mail-tr label=translations.email value=email }}
</table>
{{> promo-cta }}
{{> mail-closing }}
{{/mail-layout}}
