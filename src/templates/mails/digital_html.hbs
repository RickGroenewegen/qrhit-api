{{#> mail-layout title=productName preheader=translations.greatNewsDigital }}
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.greatNewsDigital }}</p>
{{!-- Download first, right under "click the button below"; corrections as the quieter second choice --}}
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 10px;">
    <tr>
        <td align="center" style="padding-bottom: 14px;">{{> mail-btn-pop href=digitalDownloadLink label=translations.downloadButton }}</td>
    </tr>
    <tr>
        <td align="center" style="padding-bottom: 14px;">{{> mail-btn-outline href=digitalDownloadCorrectionLink label=translations.correctionButton }}</td>
    </tr>
    {{#if sendPhysicalLink}}
    <tr>
        <td align="center" style="padding-bottom: 14px;">{{> mail-btn-outline href=downloadLink label=translations.physicalDownloadButton }}</td>
    </tr>
    {{/if}}
</table>
<p class="qr-text" style="margin: 0 0 24px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.weHopeYouHaveFunDigital }}</p>
{{#> mail-table margin="0" }}
    {{> mail-th label=translations.orderInformation first=true }}
    {{#unless giftedSet}}
    {{> mail-tr label=translations.orderNumber value=orderId }}
    {{/unless}}
    {{#each playlists}}
    {{> mail-tr label=../translations.playlist value=this.name }}
    {{/each}}
    {{> mail-tr label=translations.items value=(concat numberOfTracks " " translations.cards) }}
    {{> mail-tr label=translations.fullname value=fullname }}
    {{> mail-tr label=translations.email value=email }}
{{/mail-table}}
{{> games-section }}
{{> app-design-section }}
{{> promo-cta }}
{{#if showGiftHint}}
<p class="qr-muted" style="margin: 24px 0 0; font-size: 14px; line-height: 22px; color: #3d6d74;">🎁 {{ translations.giftHint }}</p>
{{/if}}
{{> mail-closing }}
{{/mail-layout}}
