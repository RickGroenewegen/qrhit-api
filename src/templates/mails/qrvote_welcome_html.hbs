{{#> mail-layout title=(concat productName " - Account Created") preheader=(concat "Welcome to QRVote - " productName) }}
<h1 style="margin: 0 0 20px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 26px; line-height: 32px; letter-spacing: .02em; text-transform: uppercase; color: #0b2c31;">{{ translations.title }}, {{ fullname }}!</h1>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.intro }} <strong style="color: #0b2c31;">{{ companyName }}</strong>. {{ translations.intro2 }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=verifyUrl label=translations.verifyButton }}</td>
    </tr>
</table>
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.contactWithin24h }}</p>
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.success }}<br><strong style="color: #0b2c31;">{{ translations.team }}</strong></p>
{{/mail-layout}}
