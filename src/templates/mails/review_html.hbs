{{#> mail-layout title=mail.reviewMailSubject preheader=mail.reviewMailSubject unsubscribe=unsubscribeLink }}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.reviewRequest }}</p>
<!-- Trustpilot keeps its own green -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">
            <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 auto; border-collapse: separate;">
                <tr>
                    <td align="center" bgcolor="#00b67a" style="background-color: #00b67a; border: 2px solid #0b2c31; border-radius: 999px; box-shadow: 4px 4px 0 #0b2c31;">
                        <a href="{{ reviewLinkTrustPilot }}" target="_blank" style="display: inline-block; padding: 13px 28px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 800; font-size: 14px; line-height: 20px; letter-spacing: .06em; text-transform: uppercase; color: #ffffff; text-decoration: none; border-radius: 999px;">&#9733;&nbsp;&nbsp;{{ translations.leaveReviewTrustpilot }}</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thankYou }}</p>
{{> mail-closing }}
{{/mail-layout}}
