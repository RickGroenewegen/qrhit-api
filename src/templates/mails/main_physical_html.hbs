{{#> mail-layout title=productName preheader=translations.greatNews }}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.greatNews }}</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.weHopeYouHaveFun }}</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.weHopeYouHaveFun2 }}</p>
{{#each playlists}}
{{#if (gt this.amount 1)}}
{{> mail-alert text=../translations.multipleOrdersInfo }}
{{/if}}
{{/each}}
<!-- Order details, your information, shipping and invoice address -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin: 8px 0 0;">
    {{> mail-th label=translations.orderData }}
    {{> mail-tr label=translations.orderNumber value=orderId }}
    {{#each playlists}}
    {{#if @first}}
    {{> mail-tr label=../translations.playlists value=this.name }}
    {{else}}
    {{> mail-tr label="" value=this.name }}
    {{/if}}
    {{/each}}
    <tr>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; background-color: #feefe5; font-weight: 700; font-size: 14px; line-height: 20px; color: #0b2c31; width: 40%;">{{ translations.items }}</td>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; font-size: 14px; line-height: 20px; color: #18565e;">{{ numberOfTracks }} {{ translations.cards }}</td>
    </tr>
    {{#if hasBox}}
    <tr>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; background-color: #feefe5; font-weight: 700; font-size: 14px; line-height: 20px; color: #0b2c31; width: 40%;">{{ translations.giftBoxIncluded }}</td>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; font-size: 14px; line-height: 20px; color: #18565e;">{{ boxQuantity }}x</td>
    </tr>
    {{/if}}
    {{> mail-th label=translations.yourInformation }}
    {{> mail-tr label=translations.fullname value=fullname }}
    {{> mail-tr label=translations.email value=email }}
    {{> mail-th label=translations.shippingAddress }}
    {{> mail-tr label=translations.address value=address }}
    {{> mail-tr label=translations.housenumber value=housenumber }}
    {{> mail-tr label=translations.city value=city }}
    {{> mail-tr label=translations.zipcode value=zipcode }}
    {{> mail-tr label=translations.country value=(lookup countries country) }}
    {{#if differentInvoiceAddress}}
    {{> mail-th label=translations.invoiceAddress }}
    {{> mail-tr label=translations.invoiceAddress value=invoiceAddress }}
    {{> mail-tr label=translations.invoiceHousenumber value=invoiceHousenumber }}
    {{> mail-tr label=translations.invoiceCity value=invoiceCity }}
    {{> mail-tr label=translations.invoiceZipcode value=invoiceZipcode }}
    {{> mail-tr label=translations.invoiceCountry value=(lookup countries invoiceCountry) }}
    {{/if}}
</table>
{{> mail-closing }}
{{/mail-layout}}
