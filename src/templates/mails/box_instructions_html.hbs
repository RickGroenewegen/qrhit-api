{{#> mail-layout title=translations.boxInstructionsMailSubject preheader=translations.boxInstructionsPreheader }}
<h1 class="qr-strong" style="margin: 0 0 20px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 26px; line-height: 32px; letter-spacing: .02em; text-transform: uppercase; color: #0b2c31;">{{ translations.boxInstructionsTitle }}</h1>
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.boxInstructionsIntro }} <strong class="qr-strong" style="color: #0b2c31;">{{ translations.boxInstructionsNoGlue }}</strong></p>
<p class="qr-text" style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.boxInstructionsGuideText }}</p>
<!-- Folding guide: a card with the picture, linked to the page like the button -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 28px; border-collapse: separate;">
    <tr>
        <td align="center" class="qr-panel" style="padding: 12px 12px 20px; background-color: #feefe5; border: 2px solid #18565e; border-radius: 16px;">
            <a href="{{ foldGuideLink }}" target="_blank" style="display: block; text-decoration: none;">
                <img src="{{ foldGuideImage }}" alt="{{ translations.boxInstructionsGuideImageAlt }}" width="480" style="width: 100%; max-width: 480px; height: auto; display: block; border: 0; border-radius: 10px;">
            </a>
            <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin-top: 16px;">
                <tr>
                    <td align="center">{{> mail-btn-pop href=foldGuideLink label=translations.boxInstructionsGuideButton }}</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<!-- Steps -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 24px;">
    <tr>
        <td valign="top" style="width: 40px; padding: 5px 12px 5px 0;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" class="qr-dot" style="width: 28px; height: 28px; border-radius: 14px; background-color: #f79677; border: 2px solid #0b2c31; color: #0b2c31; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-weight: 800; font-size: 13px; line-height: 28px;">1</td></tr></table></td>
        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep1 }}</td>
    </tr>
    <tr>
        <td valign="top" style="width: 40px; padding: 5px 12px 5px 0;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" class="qr-dot" style="width: 28px; height: 28px; border-radius: 14px; background-color: #f79677; border: 2px solid #0b2c31; color: #0b2c31; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-weight: 800; font-size: 13px; line-height: 28px;">2</td></tr></table></td>
        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep2 }}</td>
    </tr>
    <tr>
        <td valign="top" style="width: 40px; padding: 5px 12px 5px 0;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" class="qr-dot" style="width: 28px; height: 28px; border-radius: 14px; background-color: #f79677; border: 2px solid #0b2c31; color: #0b2c31; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-weight: 800; font-size: 13px; line-height: 28px;">3</td></tr></table></td>
        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep3 }}</td>
    </tr>
    <tr>
        <td valign="top" style="width: 40px; padding: 5px 12px 5px 0;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" class="qr-dot" style="width: 28px; height: 28px; border-radius: 14px; background-color: #f79677; border: 2px solid #0b2c31; color: #0b2c31; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-weight: 800; font-size: 13px; line-height: 28px;">4</td></tr></table></td>
        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep4 }}</td>
    </tr>
