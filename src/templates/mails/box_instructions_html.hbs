        <td valign="top" style="width: 40px; padding: 5px 12px 5px 0;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" class="qr-dot" style="width: 28px; height: 28px; border-radius: 14px; background-color: #f79677; border: 2px solid #0b2c31; color: #0b2c31; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-weight: 800; font-size: 13px; line-height: 28px;">5</td></tr></table></td>
        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep5 }}</td>
    </tr>
