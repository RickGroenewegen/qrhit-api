        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep6 }}</td>
    </tr>
    <tr>
        <td valign="top" style="width: 40px; padding: 5px 12px 5px 0;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" class="qr-dot" style="width: 28px; height: 28px; border-radius: 14px; background-color: #f79677; border: 2px solid #0b2c31; color: #0b2c31; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-weight: 800; font-size: 13px; line-height: 28px;">7</td></tr></table></td>
        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep7 }}</td>
    </tr>
    <tr>
        <td valign="top" style="width: 40px; padding: 5px 12px 5px 0;"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td align="center" class="qr-dot" style="width: 28px; height: 28px; border-radius: 14px; background-color: #f79677; border: 2px solid #0b2c31; color: #0b2c31; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-weight: 800; font-size: 13px; line-height: 28px;">8</td></tr></table></td>
        <td valign="middle" class="qr-text" style="padding: 5px 0; font-size: 15px; line-height: 23px; color: #18565e;">{{ translations.boxInstructionsStep8 }}</td>
    </tr>
</table>
<!-- Outro -->
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.boxInstructionsMoreInfo }} <a href="{{ giftBoxLink }}" target="_blank" class="qr-link" style="color: #18565e; font-weight: 600; text-decoration: underline;">{{ translations.boxInstructionsPageLink }}</a></p>
<p class="qr-text" style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thankYou }}</p>
{{> mail-closing }}
{{/mail-layout}}
