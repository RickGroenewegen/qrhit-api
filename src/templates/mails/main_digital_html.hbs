{{#> mail-layout title=productName preheader=translations.greatNewsMainDigital }}
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.greatNewsMainDigital }}</p>
<p class="qr-text" style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.weHopeYouHaveFunMainDigital }}</p>
<!-- Order details and your information -->
{{#> mail-table }}
    {{> mail-th label=translations.orderData first=true }}
    {{> mail-tr label=translations.orderNumber value=orderId }}
    {{#each playlists}}
    {{#if @first}}
    {{> mail-tr label=../translations.playlists value=this.name }}
    {{else}}
    {{> mail-tr label="" value=this.name }}
    {{/if}}
    {{/each}}
    {{> mail-tr label=translations.items value=(concat numberOfTracks " " translations.cards) }}
    {{> mail-th label=translations.yourInformation }}
    {{> mail-tr label=translations.fullname value=fullname }}
    {{> mail-tr label=translations.email value=email }}
{{/mail-table}}
{{> mail-closing }}
{{/mail-layout}}
