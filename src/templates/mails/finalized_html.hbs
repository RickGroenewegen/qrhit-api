{{#> mail-layout title=mail.trackingMailSubject preheader=mail.trackingMailSubject }}
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.youCanReview }}</p>
<!-- Second review button, phones only (shown by .qr-mobile-only in mail-layout) -->
<!--[if !mso]><!-->
<div class="qr-mobile-only" style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=reviewLink label=translations.reviewOrder }}</td>
    </tr>
</table>
</div>
<!--<![endif]-->
<!-- Make the cards your own (Off White band) -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 24px; border-collapse: separate;">
    <tr>
        <td bgcolor="#feefe5" style="padding: 24px; background-color: #feefe5; border: 2px solid #eed2bf; border-radius: 20px;">
            <p style="margin: 0 0 18px; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 18px; line-height: 24px; letter-spacing: .02em; text-transform: uppercase; color: #0b2c31;">{{ translations.reviewOwnTitle }}</p>
            <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%;">
                <tr>
                    <td class="qr-stack" valign="top" style="padding: 0 20px 0 0;">
                        <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 16px;">
                            <tr>
                                <td valign="top" style="width: 34px; font-size: 20px; line-height: 24px;">✏️</td>
                                <td valign="top">
                                    <p style="margin: 0 0 2px; font-size: 15px; line-height: 22px; font-weight: 700; color: #0b2c31;">{{ translations.reviewCorrectTitle }}</p>
                                    <p style="margin: 0; font-size: 14px; line-height: 22px; color: #18565e;">{{ translations.reviewCorrectBody }}</p>
                                </td>
                            </tr>
                        </table>
                        <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%;">
                            <tr>
                                <td valign="top" style="width: 34px; font-size: 20px; line-height: 24px;">💬</td>
                                <td valign="top">
                                    <p style="margin: 0 0 2px; font-size: 15px; line-height: 22px; font-weight: 700; color: #0b2c31;">{{ translations.reviewExtraTitle }}</p>
                                    <p style="margin: 0; font-size: 14px; line-height: 22px; color: #18565e;">{{ translations.reviewExtraBody }}</p>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td class="qr-stack" valign="top" align="center" style="width: 210px; padding: 0;">
                        <!-- Example card back: the extra lines sit below artist and title in a smaller font -->
                        <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 auto; border-collapse: separate;">
                            <tr>
                                <td align="center" valign="middle" width="172" height="172" bgcolor="#ffffff" style="width: 172px; height: 172px; padding: 12px; background-color: #ffffff; border: 2px solid #18565e; border-radius: 14px; box-shadow: 4px 4px 0 #18565e; text-align: center;">
                                    <p style="margin: 0; font-size: 15px; line-height: 20px; font-weight: 600; color: #0b2c31;">Queen</p>
                                    <p style="margin: 3px 0 0; font-family: Arial, sans-serif; font-size: 10px; line-height: 14px; color: #0b2c31;">{{ translations.reviewExampleArtistExtra }}</p>
                                    <p style="margin: 10px 0; font-size: 34px; line-height: 38px; font-weight: 800; color: #0b2c31;">1975</p>
                                    <p style="margin: 0; font-size: 15px; line-height: 20px; font-weight: 600; color: #0b2c31;">Bohemian Rhapsody</p>
                                    <p style="margin: 3px 0 0; font-family: Arial, sans-serif; font-size: 10px; line-height: 14px; color: #0b2c31;">{{ translations.reviewExampleTitleExtra }}</p>
                                </td>
                            </tr>
                        </table>
                        <p style="margin: 14px 0 0; font-size: 12px; line-height: 18px; color: #3d6d74; text-align: center;">{{ translations.reviewExampleCaption }}</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.reviewAutoShip }}</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 4px 0 24px;">
    <tr>
        <td align="center">{{> mail-btn-pop href=reviewLink label=translations.reviewOrder }}</td>
    </tr>
</table>
<p style="margin: 0; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.thankYou }}</p>
{{> promo-cta }}
{{> mail-closing }}
{{/mail-layout}}
