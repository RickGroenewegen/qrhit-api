{{#> mail-layout title=translations.boxUpgradeBody preheader=translations.boxUpgradeBody }}
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ payment.fullname }},</p>
<p style="margin: 0 0 16px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.boxUpgradeBody }}</p>
<p style="margin: 0 0 20px; font-size: 16px; line-height: 26px; color: #18565e;">{{ translations.boxUpgradeThankYou }}</p>
<!-- Order details -->
<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin: 8px 0 0;">
    {{> mail-th label=translations.boxUpgradeOrderDetails }}
    {{> mail-tr label=translations.boxUpgradePlaylist value=playlist.name }}
    {{> mail-tr label=translations.boxUpgradeQuantity value=quantity }}
    {{> mail-tr label=translations.boxUpgradeGiftBox prefix="&euro;" value=boxPriceFormatted }}
    {{> mail-tr label=translations.boxUpgradeShipping prefix="&euro;" value=shippingCost }}
    <tr>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; background-color: #feefe5; font-weight: 700; font-size: 14px; line-height: 20px; color: #0b2c31; width: 40%;">{{ translations.boxUpgradeTotal }}</td>
        <td style="padding: 11px 14px; border: 1px solid #eed2bf; font-size: 15px; line-height: 20px; font-weight: 700; color: #0b2c31;">&euro;{{ totalPrice }}</td>
    </tr>
    {{> mail-th label=translations.yourInformation }}
    {{> mail-tr label=translations.fullname value=fullname }}
    {{> mail-tr label=translations.email value=email }}
    {{> mail-th label=translations.shippingAddress }}
    {{> mail-tr label=translations.address value=address }}
    {{> mail-tr label=translations.housenumber value=housenumber }}
    {{> mail-tr label=translations.city value=city }}
    {{> mail-tr label=translations.zipcode value=zipcode }}
    {{> mail-tr label=translations.country value=(lookup countries country) }}
</table>
{{> mail-closing }}
{{/mail-layout}}
