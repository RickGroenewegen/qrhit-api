<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Your QR Cards</title>
<!-- Open Sans is used as the web-safe stand-in for Tahoma (same large x-height,
     flat terminals and open apertures; Tahoma itself is not available on the
     PDF rendering Lambda). -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;700&display=block" rel="stylesheet">
<style>
    body {
        font-family: 'Open Sans', Tahoma, Verdana, Arial, sans-serif;
        margin: 0;
        padding: 0;
    }
    .card-front, .card-back {
        width: 60mm;
        height: 60mm;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }
    .card-front {
        overflow: hidden;
    }
    .card-front::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        <% if (php.backgroundFrontType !== 'solid') { %>
            <% if (php.background && php.background.length) { %>
            background-image: url('<%= process.env['API_URI'] %>/public/background/<%= php.background %>');
            <% } else { %>
            background-image: url('<%= process.env['API_URI'] %>/assets/images/background_new.png');
            <% } %>
            background-size: cover;
            background-position: center;
        <% } %>
        opacity: <%= (php.frontOpacity !== undefined ? php.frontOpacity : 100) / 100 %>;
        z-index: 0;
    }
    .card-back {
        position: relative;
        overflow: hidden;
        <% if (php.backgroundBackType === 'solid') { %>
            <% if (php.useGradient) {
                const firstStop = Math.max(0, php.gradientPosition - 50);
                const secondStop = Math.min(100, php.gradientPosition + 50);
                const bgColor = php.backgroundBackColor || '#ffffff';
                const gradColor = php.gradientBackgroundColor || '#ffffff';
                const degrees = php.gradientDegrees || 180;
            %>
            background: linear-gradient(<%= degrees %>deg, <%= bgColor %> <%= firstStop %>%, <%= gradColor %> <%= secondStop %>%);
            <% } else if (php.backgroundBackColor) { %>
            background-color: <%= php.backgroundBackColor %>;
            <% } else { %>
            background-color: #ffffff;
            <% } %>
        <% } else { %>
        background-color: transparent;
        <% } %>
    }
    .background-image-back {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        opacity: <%= (php.backOpacity !== undefined ? php.backOpacity : 50) / 100 %>;
    }
    .qr {
        width: 52%;
        height: auto;
        position: relative;
        z-index: 3;
    }
    /* Left aligned text block, positioned to match the Klomp card artwork */
    .klomp-text {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 12.5mm;
        width: 36mm;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        text-align: left;
        z-index: 1;
    }
    .klomp-group {
        width: 100%;
    }
    .klomp-group + .klomp-group {
        margin-top: 2mm;
    }
    .klomp-label {
        font-weight: 700;
        color: #D66636;
    }
    .klomp-value {
        font-weight: 400;
        color: #1C1C1C;
        overflow-wrap: break-word;
        word-wrap: break-word;
    }
    .klomp-extra {
        font-weight: 400;
        color: #1C1C1C;
        overflow-wrap: break-word;
        word-wrap: break-word;
    }
    .logo {
        position: absolute;
        top: 4mm;
        left: 50%;
        transform: translateX(-50%);
        max-height: 2rem;
        z-index: 4;
    }
</style>
</head>
<body>
<% if (php.addHowToCard && startIndex === 0) { %>
  <%- include('partials/howto_card') %>
<% } %>
<% tracks.forEach((track, index) => { %>
    <div class="card-front" style="<%= !eco && php.backgroundFrontType === 'solid' ? (php.useFrontGradient ? 'background: linear-gradient(' + (php.gradientFrontDegrees || 180) + 'deg, ' + (php.backgroundFrontColor || '#ffffff') + ' ' + Math.max(0, (php.gradientFrontPosition || 50) - 50) + '%, ' + (php.gradientFrontColor || '#ffffff') + ' ' + Math.min(100, (php.gradientFrontPosition || 50) + 50) + '%);' : 'background: ' + (php.backgroundFrontColor || '#ffffff') + ';') : '' %>">
        <% if (php.logo && php.logo.length) { %>
            <img class="logo" src="<%= process.env['API_URI'] %>/public/logo/<%= php.logo %>" alt="Logo" style="<%= eco ? 'filter: grayscale(100%);' : '' %>">
        <% } %>
        <%
        // Determine QR background type - handle backward compatibility
        let qrBgType = php.qrBackgroundType || (php.hideCircle ? 'none' : 'square');
        let qrBgColor = php.qrBackgroundColor || '#ffffff';
        %>
        <% if (qrBgType === 'square') { %>
            <!-- Square background for QR code using SVG -->
            <svg style="position: absolute; width: 31.8mm; height: 31.8mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1;" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="0" width="100%" height="100%" fill="<%= qrBgColor %>" />
            </svg>
            <img src="<%= process.env['API_URI'] %>/public/qr/<%= subdir %>/<%= track.trackId %>.png" alt="QR Code" style="position: absolute; width: 28mm; height: 28mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2;">
        <% } else if (qrBgType === 'circle') { %>
            <!-- Circle background for QR code using SVG -->
            <svg style="position: absolute; width: 42mm; height: 42mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1;" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50%" cy="50%" r="21mm" fill="<%= qrBgColor %>" />
            </svg>
            <img src="<%= process.env['API_URI'] %>/public/qr/<%= subdir %>/<%= track.trackId %>.png" alt="QR Code" style="position: absolute; width: 32mm; height: 32mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2;">
        <% } else { %>
            <!-- No background shape -->
            <img src="<%= process.env['API_URI'] %>/public/qr/<%= subdir %>/<%= track.trackId %>.png" alt="QR Code" class="qr">
        <% } %>
    </div>
    <div style="page-break-after: always;"></div>
    <%
    // 13px matches the artwork. Long artist/title combinations wrap onto extra
    // lines, so estimate the block height and step the size down until it fits
    // inside the white area of the card (~45mm of usable height).
    const klompBoxWidth = 36 * 96 / 25.4;  // text column width in css px
    const klompMaxHeight = 45 * 96 / 25.4; // usable height in css px
    const klompGaps = 2 * (2 * 96 / 25.4); // the two 2mm gaps between groups
    const klompArtist = (track.artist || '') + (track.extraArtistAttribute || '');
    const klompName = (track.name || '') + (track.extraNameAttribute || '');
    let klompFontSize = 13;
    for (const size of [13, 12, 11, 10, 9]) {
        klompFontSize = size;
        // ~0.47em is the average glyph advance for this typeface
        const perLine = Math.max(8, Math.floor(klompBoxWidth / (size * 0.47)));
        const lines =
            3 + // the three labels
            1 + // the year
            Math.ceil(klompArtist.length / perLine) +
            Math.ceil(klompName.length / perLine);
        if (lines * size * 1.15 + klompGaps <= klompMaxHeight) break;
    }
    const klompExtraSize = Math.max(8, klompFontSize - 3);
    %>
    <div class="card-back" style="position: relative;">
        <% if (php.backgroundBackType !== 'solid' && php.backgroundBack && php.backgroundBack.length) { %>
            <img class="background-image-back" src="<%= process.env['API_URI'] %>/public/background/<%= php.backgroundBack %>" alt="Card Background">
        <% } %>
        <div class="klomp-text" style="font-size: <%= klompFontSize %>px; line-height: 1.15;">
            <div class="klomp-group">
                <div class="klomp-label">Artiest:</div>
                <div class="klomp-value"><%= track.artist %></div>
                <% if (track.extraArtistAttribute && track.extraArtistAttribute.length > 0) { %>
                    <div class="klomp-extra" style="font-size: <%= klompExtraSize %>px;"><%= track.extraArtistAttribute %></div>
                <% } %>
            </div>
            <div class="klomp-group">
                <div class="klomp-label">Titel:</div>
                <div class="klomp-value"><%= track.name %></div>
                <% if (track.extraNameAttribute && track.extraNameAttribute.length > 0) { %>
                    <div class="klomp-extra" style="font-size: <%= klompExtraSize %>px;"><%- track.extraNameAttribute %></div>
                <% } %>
            </div>
            <div class="klomp-group">
                <div class="klomp-label">Jaartal:</div>
                <div class="klomp-value"><%= track.year %></div>
            </div>
        </div>
    </div>
    <div style="page-break-after: always;"></div>
<% }); %>
</body>
</html>
