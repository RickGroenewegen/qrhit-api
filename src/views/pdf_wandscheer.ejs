<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Your QR Cards</title>
<%#
  Wandscheer: the single-card printer layout (pdf_printer.ejs) with two
  changes on the back. The track's extra name attribute is not a subtitle
  under the track name here; it carries a second year (the "SRN year") and is
  printed directly under the original year. The font is fixed to Unna
  regardless of the designer's choice: everything Unna Regular, the original
  year Unna Bold.
%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unna:wght@400;700&display=block" rel="stylesheet">
<style>
    body {
        font-family: 'Unna', Georgia, serif;
        font-weight: 400;
        margin: 0;
        padding: 0;
    }
    .card-front, .card-back {
        width: 60mm;
        height: 60mm;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }
    .card-front {
        overflow: hidden;
    }
    .card-front::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        <% if (php.backgroundFrontType !== 'solid') { %>
            <% if (php.background && php.background.length) { %>
            background-image: url('<%= process.env['API_URI'] %>/public/background/<%= php.background %>');
            <% } else { %>
            background-image: url('<%= process.env['API_URI'] %>/assets/images/background_brand.png');
            <% } %>
            background-size: cover;
            background-position: center;
        <% } %>
        opacity: <%= (php.frontOpacity !== undefined ? php.frontOpacity : 100) / 100 %>;
        z-index: 0;
    }
    /* White square styling removed - now using SVG */
    .card-back {
        position: relative;
        overflow: hidden;
        <% if (php.backgroundBackType === 'solid') { %>
            <% if (php.useGradient) {
                const firstStop = Math.max(0, php.gradientPosition - 50);
                const secondStop = Math.min(100, php.gradientPosition + 50);
                const bgColor = php.backgroundBackColor || '#ffffff';
                const gradColor = php.gradientBackgroundColor || '#ffffff';
                const degrees = php.gradientDegrees || 180;
            %>
            background: linear-gradient(<%= degrees %>deg, <%= bgColor %> <%= firstStop %>%, <%= gradColor %> <%= secondStop %>%);
            <% } else if (php.backgroundBackColor) { %>
            background-color: <%= php.backgroundBackColor %>;
            <% } else { %>
            background-color: #ffffff;
            <% } %>
        <% } else { %>
        background-color: transparent;
        <% } %>
    }
    .background-image-back {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        opacity: <%= (php.backOpacity !== undefined ? php.backOpacity : 50) / 100 %>;
    }
    .qr {
        width: 60%;
        height: auto;
        position: relative;
        z-index: 3;
    }
    .text {
        text-align: center;
        padding-top: 2mm;
        padding-bottom: 2mm;
    }
    .text.artist {
        margin-left: 3mm;
        margin-right: 3mm;
        font-family: 'Unna', Georgia, serif;
        font-weight: 400;
        font-size: 16px;
        overflow-wrap: break-word; /* Prevent breaking mid-word */
    }
    .text.year {
        font-family: 'Unna', Georgia, serif;
        font-weight: 700;
        font-size: 42px;
        line-height: 1.1;
    }
    .text.extra-year {
        font-family: 'Unna', Georgia, serif;
        font-weight: 400;
        font-size: 16px;
        /* Sits tight under the year: cancel its own top padding and part of the year's bottom padding. */
        padding-top: 0;
        margin-top: -1mm;
    }
    .text.name {
        margin-left: 3mm;
        margin-right: 3mm;
        font-family: 'Unna', Georgia, serif;
        font-weight: 400;
        font-size: 16px;
        overflow-wrap: break-word; /* Prevent breaking mid-word */
    }
    .text .extra-attribute {
        font-family: 'Unna', Georgia, serif;
        font-weight: 400;
        font-size: 10px;
        margin-top: 1mm;
    }
    .url, .url-bottom {
        font-size: 11px;
        position: absolute;
        bottom: 13mm;
        text-align: center;
        width: 100%;
        color: #6f8a8e; /* Brand ink at 55% */
        z-index: 3;
    }
    .logo {
        position: absolute;
        top: 6mm;
        left: 50%;
        transform: translateX(-50%);
        height: 2rem;
        width: auto;
        max-width: 54mm;
        object-fit: contain;
        z-index: 4;
    }
    .url-bottom {
        bottom: 5mm;
    }
</style>
</head>
<body>
<!-- Force Unna 400 + 700 to be fetched before layout finalises (prevents faux-bold fallback in PDF renderer) -->
<div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;visibility:hidden;">
    <span style="font-family:'Unna',serif;font-weight:400;">Unna Regular 0123456789</span>
    <span style="font-family:'Unna',serif;font-weight:700;">Unna Bold 0123456789</span>
</div>
<% if (php.addHowToCard && startIndex === 0) { %>
  <%- include('partials/howto_card') %>
<% } %>
<% tracks.forEach((track, index) => { %>
    <div class="card-front" style="<%= !eco && php.backgroundFrontType === 'solid' ? (php.useFrontGradient ? 'background: linear-gradient(' + (php.gradientFrontDegrees || 180) + 'deg, ' + (php.backgroundFrontColor || '#ffffff') + ' ' + Math.max(0, (php.gradientFrontPosition || 50) - 50) + '%, ' + (php.gradientFrontColor || '#ffffff') + ' ' + Math.min(100, (php.gradientFrontPosition || 50) + 50) + '%);' : 'background: ' + (php.backgroundFrontColor || '#ffffff') + ';') : '' %>">
        <% if (php.logo && php.logo.length) { %>
            <img class="logo" src="<%= process.env['API_URI'] %>/public/logo/<%= php.logo %>" alt="Logo" style="<%= eco ? 'filter: grayscale(100%);' : '' %>">
        <% } %>
        <%
        // Determine QR background type - handle backward compatibility
        let qrBgType = php.qrBackgroundType || (php.hideCircle ? 'none' : 'square');
        let qrBgColor = php.qrBackgroundColor || '#ffffff';
        %>
        <% if (qrBgType === 'square') { %>
            <!-- Square background for QR code using SVG -->
            <svg style="position: absolute; width: 36.3mm; height: 36.3mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1;" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="0" width="100%" height="100%" fill="<%= qrBgColor %>" />
            </svg>
            <img src="<%= process.env['API_URI'] %>/public/qr/<%= subdir %>/<%= track.trackId %>.png" alt="QR Code" style="position: absolute; width: 32mm; height: 32mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2;">
        <% } else if (qrBgType === 'circle') { %>
            <!-- Circle background for QR code using SVG -->
            <svg style="position: absolute; width: 48mm; height: 48mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1;" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50%" cy="50%" r="24mm" fill="<%= qrBgColor %>" />
            </svg>
            <img src="<%= process.env['API_URI'] %>/public/qr/<%= subdir %>/<%= track.trackId %>.png" alt="QR Code" style="position: absolute; width: 36mm; height: 36mm; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2;">
        <% } else { %>
            <!-- No background shape -->
            <img src="<%= process.env['API_URI'] %>/public/qr/<%= subdir %>/<%= track.trackId %>.png" alt="QR Code" class="qr">
        <% } %>
        <!-- Domain URL removed - always hidden -->
    </div>
    <div style="page-break-after: always;"></div>
    <div class="card-back" style="position: relative;">
        <% if (php.backgroundBackType !== 'solid' && php.backgroundBack && php.backgroundBack.length) { %>
            <img class="background-image-back" src="<%= process.env['API_URI'] %>/public/background/<%= php.backgroundBack %>" alt="Card Background">
        <% } %>
        <div style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%; width: 100%; position: relative; z-index: 1;">
            <div class="text artist" style="padding: 0 6mm;color:<%= php.fontColor || '#000000' %>;">
                <%= track.artist %>
                <% if (track.extraArtistAttribute && track.extraArtistAttribute.length > 0) { %>
                    <div class="extra-attribute"><%= track.extraArtistAttribute %></div>
                <% } %>
            </div>
            <div class="text year" style="margin-top: 3mm;padding: 0 6mm;color:<%= php.fontColor || '#000000' %>;"><%= track.year %></div>
            <% if (track.extraNameAttribute && track.extraNameAttribute.length > 0) { %>
                <div class="text extra-year" style="padding: 0 6mm;color:<%= php.fontColor || '#000000' %>;"><%= track.extraNameAttribute %></div>
            <% } %>
            <div class="text name" style="margin-top: 3mm;padding: 0 6mm;color:<%= php.fontColor || '#000000' %>;">
                <%= track.name %>
            </div>
        </div>
        <!-- Domain URL removed from back side - always hidden -->
    </div>
    <div style="page-break-after: always;"></div>
<% }); %>
</body>
</html>
