<%# Shared terms & conditions block for all quotation templates.
    Canonical text is the Schneiders/QRSong! version, now sourced from the
    formal business locale bundle (locales/business/<locale>.json). Pass
    `brandName` to brand the liability clauses (e.g. 'QRSong!' or 'OnzeVibe'). %>
<!-- Terms and Conditions (Page 3) -->
<div class="terms-section">
    <h2 class="section-title"><%= t('termsTitle') %></h2>
    <ol class="terms-list">
        <li><%= t('terms01') %></li>
        <li><%= t('terms02') %></li>
        <li><%= t('terms03') %></li>
        <li><%= t('terms04') %></li>
        <li><%= t('terms05', { validUntil: formatDate(validUntil) }) %></li>
        <li><%= t('terms06') %></li>
        <li><%= t('terms07') %></li>
        <li><%= t('terms08') %></li>
        <li><%= t('terms09') %></li>
        <li><%= t('terms10') %></li>
        <li><%= t('terms11') %></li>
        <li><%= t('terms12') %></li>
        <li><%= t('terms13', { brandName }) %></li>
        <li><%= t('terms14', { brandName }) %></li>
    </ol>
</div>

<div class="terms-section">
    <h2 class="section-title"><%= t('ipTitle') %></h2>
    <ol class="terms-list">
        <li><%= t('ip1') %></li>
        <li><%= t('ip2') %></li>
        <li><%= t('ip3') %></li>
        <li><%= t('ip4') %></li>
        <li><%= t('ip5') %></li>
    </ol>
</div>
