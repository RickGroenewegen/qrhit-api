<!--
    Cover page - shared between the price-list brochure and the playlist
    suggestions brochure.
    A single DISCO panel on OFF WHITE paper, carrying the brand kit's
    teal/coral line texture, with the grain-textured treble clef bleeding
    off the right edge.

    Expects: baseUrl, formatDate, title, subtitle, editionName, version
    Optional:
      contents  [{ name, note }] for the tracklist; default coverTrack1-3
      promises  [string] printed under the tagline
      neutral   true for the edition a reseller forwards: no wordmark, no
                web address, a "powered by" credit instead
-->
<style>
    .cover {
        width: 210mm;
        height: 297mm;
        box-sizing: border-box;
        background: var(--off);
        padding: 10mm;
        display: flex;
    }

    .cover-panel {
        flex: 1;
        position: relative;
        overflow: hidden;
        border-radius: 10mm;
        background: var(--disco);
        color: var(--off);
        padding: 16mm 16mm 14mm;
        display: flex;
        flex-direction: column;
    }

    /* Brand kit texture: teal ground, coral line-work, plastic crinkle */
    .cover-texture {
        position: absolute;
        inset: 0;
        background-image: url('<%= baseUrl %>/assets/images/brand/texture_disco.jpg');
        background-size: cover;
        background-position: center;
        opacity: 0.78;
    }

    /* Sits in the clear right-hand band: below the sticker, above the
       catalogue strip, clear of the tracklist column. */
    .cover-clef {
        position: absolute;
        right: -24mm;
        top: 30mm;
        width: 96mm;
        opacity: 0.9;
    }

    .cover-clef img {
        display: block;
        width: 100%;
        height: auto;
    }

    .cover-inner {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .cover-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 40mm;
    }

    .cover-logo {
        height: 42px;
        width: auto;
    }

    .cover-kicker {
        font-family: var(--display);
        font-weight: 900;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pop);
        margin-bottom: 12px;
    }

    .cover-title {
        font-family: var(--display);
        font-weight: 900;
        font-size: 50px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        line-height: 1.0;
        margin-bottom: 16px;
        max-width: 128mm;
    }

    .cover-rule {
        width: 46mm;
        height: 4px;
        border-radius: 2px;
        background: var(--pop);
        margin-bottom: 16px;
    }

    .cover-tagline {
        font-size: 13.5px;
        color: var(--off-70);
        max-width: 96mm;
        line-height: 1.55;
    }

    /* Contents, set as a tracklist */
    .cover-tracks {
        margin-top: auto;
        max-width: 112mm;
    }

    .cover-tracks-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pop);
        padding-bottom: 8px;
        margin-bottom: 3px;
        border-bottom: 1px solid var(--off-20);
    }

    .cover-track {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 7px 0;
        border-bottom: 1px solid var(--off-20);
    }

    .cover-track-num {
        font-family: var(--display);
        font-weight: 900;
        font-size: 9px;
        letter-spacing: 0.07em;
        color: var(--pop);
        width: 18px;
        flex-shrink: 0;
    }

    .cover-track-name {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--off);
        flex: 1;
    }

    .cover-track-note {
        font-size: 9px;
        color: var(--off-45);
    }

    .cover-foot {
        margin-top: 14mm;
        padding-top: 11px;
        border-top: 1px solid var(--off-20);
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .cover-foot-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .cover-foot-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7px;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--off-45);
    }

    .cover-foot-value {
        font-size: 12px;
        font-weight: 600;
        color: var(--off);
    }

    .cover-foot-value.pop {
        color: var(--pop);
    }

    .cover-promises {
        list-style: none;
        margin-top: 18px;
        max-width: 110mm;
    }

    .cover-promises li {
        position: relative;
        padding-left: 20px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.4;
        color: var(--off);
        margin-bottom: 7px;
    }

    .cover-promises li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 4px;
        width: 9px;
        height: 9px;
        border-radius: 99px;
        background: var(--pop);
    }

    .cover-powered {
        font-size: 10px;
        color: var(--off-70);
        letter-spacing: 0.02em;
    }

    .cover-powered strong {
        font-family: var(--display);
        font-weight: 900;
        letter-spacing: 0.06em;
        color: var(--off);
    }
</style>

<%
    var coverNeutral = !!locals.neutral;
    var coverContents = locals.contents || [
        { name: t('coverTrack1'), note: t('coverTrack1Note') },
        { name: t('coverTrack2'), note: t('coverTrack2Note') },
        { name: t('coverTrack3'), note: t('coverTrack3Note') }
    ];
%>
<div class="cover">
    <div class="cover-panel">
        <div class="cover-texture"></div>
        <div class="cover-clef">
            <img src="<%= baseUrl %>/assets/images/brand/clef_pop.png" alt="" />
        </div>

        <div class="cover-inner">
            <div class="cover-top">
                <% if (coverNeutral) { %>
                <div class="cover-powered">powered by <strong>QRSong!</strong></div>
                <% } else { %>
                <img src="<%= baseUrl %>/assets/images/logo_white.png" alt="QRSong!" class="cover-logo" />
                <% } %>
                <div class="sticker"><%= editionName %></div>
            </div>

            <div class="cover-kicker"><%= t('coverKicker') %></div>
            <div class="cover-title"><%= title %></div>
            <div class="cover-rule"></div>
            <div class="cover-tagline"><%= t('coverTagline') %></div>

            <% if (locals.promises) { %>
            <ul class="cover-promises">
                <% promises.forEach(function (promise) { %>
                <li><%= promise %></li>
                <% }); %>
            </ul>
            <% } %>

            <div class="cover-tracks">
                <div class="cover-tracks-label"><%= t('coverContents') %></div>
                <% coverContents.forEach(function (item, i) { %>
                <div class="cover-track">
                    <span class="cover-track-num"><%= String(i + 1).padStart(2, '0') %></span>
                    <span class="cover-track-name"><%= item.name %></span>
                    <span class="cover-track-note"><%= item.note %></span>
                </div>
                <% }); %>
            </div>

            <div class="cover-foot">
                <div class="cover-foot-item">
                    <div class="cover-foot-label"><%= t('coverEdition') %></div>
                    <div class="cover-foot-value"><%= formatDate(new Date()) %></div>
                </div>
                <div class="cover-foot-item">
                    <div class="cover-foot-label"><%= t('coverVersion') %></div>
                    <div class="cover-foot-value"><%= version %></div>
                </div>
                <% if (!coverNeutral) { %>
                <div class="cover-foot-item">
                    <div class="cover-foot-label"><%= t('coverContact') %></div>
                    <div class="cover-foot-value pop">www.qrsong.io</div>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
