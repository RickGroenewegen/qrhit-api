<!--
    Cover page - shared between the Reseller and Retail PDFs.
    A single DISCO panel on OFF WHITE paper, carrying the brand kit's
    teal/coral line texture, with the grain-textured treble clef bleeding
    off the right edge.

    Expects: baseUrl, formatDate, title, subtitle, editionName, version
-->
<style>
    .cover {
        width: 210mm;
        height: 297mm;
        box-sizing: border-box;
        background: var(--off);
        padding: 10mm;
        display: flex;
    }

    .cover-panel {
        flex: 1;
        position: relative;
        overflow: hidden;
        border-radius: 10mm;
        background: var(--disco);
        color: var(--off);
        padding: 16mm 16mm 14mm;
        display: flex;
        flex-direction: column;
    }

    /* Brand kit texture: teal ground, coral line-work, plastic crinkle */
    .cover-texture {
        position: absolute;
        inset: 0;
        background-image: url('<%= baseUrl %>/assets/images/brand/texture_disco.jpg');
        background-size: cover;
        background-position: center;
        opacity: 0.78;
    }

    /* Sits in the clear right-hand band: below the sticker, above the
       catalogue strip, clear of the tracklist column. */
    .cover-clef {
        position: absolute;
        right: -24mm;
        top: 30mm;
        width: 96mm;
        opacity: 0.9;
    }

    .cover-clef img {
        display: block;
        width: 100%;
        height: auto;
    }

    .cover-inner {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .cover-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 40mm;
    }

    .cover-logo {
        height: 42px;
        width: auto;
    }

    .cover-kicker {
        font-family: var(--display);
        font-weight: 900;
        font-size: 9px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pop);
        margin-bottom: 12px;
    }

    .cover-title {
        font-family: var(--display);
        font-weight: 900;
        font-size: 50px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        line-height: 1.0;
        margin-bottom: 16px;
        max-width: 128mm;
    }

    .cover-rule {
        width: 46mm;
        height: 4px;
        border-radius: 2px;
        background: var(--pop);
        margin-bottom: 16px;
    }

    .cover-tagline {
        font-size: 13.5px;
        color: var(--off-70);
        max-width: 96mm;
        line-height: 1.55;
    }

    /* Contents, set as a tracklist */
    .cover-tracks {
        margin-top: auto;
        max-width: 112mm;
    }

    .cover-tracks-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pop);
        padding-bottom: 8px;
        margin-bottom: 3px;
        border-bottom: 1px solid var(--off-20);
    }

    .cover-track {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 7px 0;
        border-bottom: 1px solid var(--off-20);
    }

    .cover-track-num {
        font-family: var(--display);
        font-weight: 900;
        font-size: 9px;
        letter-spacing: 0.07em;
        color: var(--pop);
        width: 18px;
        flex-shrink: 0;
    }

    .cover-track-name {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--off);
        flex: 1;
    }

    .cover-track-note {
        font-size: 9px;
        color: var(--off-45);
    }

    .cover-foot {
        margin-top: 14mm;
        padding-top: 11px;
        border-top: 1px solid var(--off-20);
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .cover-foot-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .cover-foot-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7px;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--off-45);
    }

    .cover-foot-value {
        font-size: 12px;
        font-weight: 600;
        color: var(--off);
    }

    .cover-foot-value.pop {
        color: var(--pop);
    }
</style>

<div class="cover">
    <div class="cover-panel">
        <div class="cover-texture"></div>
        <div class="cover-clef">
            <img src="<%= baseUrl %>/assets/images/brand/clef_pop.png" alt="" />
        </div>

        <div class="cover-inner">
            <div class="cover-top">
                <img src="<%= baseUrl %>/assets/images/logo_white.png" alt="QRSong!" class="cover-logo" />
                <div class="sticker"><%= editionName %></div>
            </div>

            <div class="cover-kicker"><%= t('coverKicker') %></div>
            <div class="cover-title"><%= title %></div>
            <div class="cover-rule"></div>
            <div class="cover-tagline"><%= t('coverTagline') %></div>

            <div class="cover-tracks">
                <div class="cover-tracks-label"><%= t('coverContents') %></div>
                <div class="cover-track">
                    <span class="cover-track-num">01</span>
                    <span class="cover-track-name"><%= t('coverTrack1') %></span>
                    <span class="cover-track-note"><%= t('coverTrack1Note') %></span>
                </div>
                <div class="cover-track">
                    <span class="cover-track-num">02</span>
                    <span class="cover-track-name"><%= t('coverTrack2') %></span>
                    <span class="cover-track-note"><%= t('coverTrack2Note') %></span>
                </div>
                <div class="cover-track">
                    <span class="cover-track-num">03</span>
                    <span class="cover-track-name"><%= t('coverTrack3') %></span>
                    <span class="cover-track-note"><%= t('coverTrack3Note') %></span>
                </div>
            </div>

            <div class="cover-foot">
                <div class="cover-foot-item">
                    <div class="cover-foot-label"><%= t('coverEdition') %></div>
                    <div class="cover-foot-value"><%= formatDate(new Date()) %></div>
                </div>
                <div class="cover-foot-item">
                    <div class="cover-foot-label"><%= t('coverVersion') %></div>
                    <div class="cover-foot-value"><%= version %></div>
                </div>
                <div class="cover-foot-item">
                    <div class="cover-foot-label"><%= t('coverContact') %></div>
                    <div class="cover-foot-value pop">www.qrsong.io</div>
                </div>
            </div>
        </div>
    </div>
</div>
