<%
// Font embedding for reliable PDF conversion
let fontStyles = '';
if (php.selectedFont && php.selectedFont !== 'Arial, sans-serif') {
    // Extract the font name before the comma
    let fontName = php.selectedFont.split(',')[0].trim().replace(/["']/g, '');
    // Weight variants lead with a private alias, so the family to request from
    // Google is looked up rather than derived from the CSS string.
    let googleFontName = (typeof getGoogleFontName === 'function' ? getGoogleFontName(php.selectedFont) : fontName).replace(/ /g, '+');
    let weights = typeof getGoogleFontWeights === 'function' ? getGoogleFontWeights(php.selectedFont) : '400;700';
    let fontWeight = typeof getFontWeight === 'function' ? getFontWeight(php.selectedFont) : '';
    let weightRule = fontWeight ? `font-weight: ${fontWeight} !important;` : '';

    fontStyles = `
    <style>
        @import url('https://fonts.googleapis.com/css2?family=${googleFontName}:wght@${weights}&display=swap');

        body {
            font-family: '${fontName}', ${php.selectedFont.split(',').slice(1).join(',')}, Arial, sans-serif !important;
            ${weightRule}
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .text, .text.artist, .text.year, .text.name {
            font-family: '${fontName}', ${php.selectedFont.split(',').slice(1).join(',')}, Arial, sans-serif !important;
            ${weightRule}
        }

        .text.year {
            font-family: '${fontName}', ${php.selectedFont.split(',').slice(1).join(',')}, Arial, sans-serif !important;
            font-weight: bold !important;
        }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=${googleFontName}:wght@${weights}&display=swap" rel="stylesheet">
    `;
} else {
    fontStyles = `
    <style>
        body, .text, .text.artist, .text.year, .text.name {
            font-family: Arial, sans-serif !important;
        }
    </style>`;
}

// Alternating card designs (src/cardDesigns.ts). The rules above set design
// 1's font on every card. A card of design k (0-based, k >= 1) also carries
// the class d<k>; when that design has another font, it is loaded here and
// scoped to those cards. Nothing is added for a single design.
let designFontStyles = '';
const fontDeck = typeof designs !== 'undefined' && Array.isArray(designs) ? designs : [];
const baseFont = php.selectedFont || 'Arial, sans-serif';
const weightOf = (font) => (typeof getFontWeight === 'function' ? getFontWeight(font) : '');
const loadedFonts = new Set([baseFont]);
fontDeck.forEach((design, k) => {
    const font = design.selectedFont || 'Arial, sans-serif';
    if (k === 0 || font === baseFont) return;

    let family = 'Arial, sans-serif';
    if (font !== 'Arial, sans-serif') {
        const name = font.split(',')[0].trim().replace(/["']/g, '');
        family = `'${name}', ${font.split(',').slice(1).join(',')}, Arial, sans-serif`;
        if (!loadedFonts.has(font)) {
            loadedFonts.add(font);
            const googleName = (typeof getGoogleFontName === 'function' ? getGoogleFontName(font) : name).replace(/ /g, '+');
            const weights = typeof getGoogleFontWeights === 'function' ? getGoogleFontWeights(font) : '400;700';
            designFontStyles += `
    <link href="https://fonts.googleapis.com/css2?family=${googleName}:wght@${weights}&display=swap" rel="stylesheet">`;
        }
    }

    // Design 1's weight rule reaches every .text, so a design without a
    // weight of its own has to set it back; the year stays bold.
    const weight = weightOf(font);
    const resetWeight = !weight && !!weightOf(baseFont);
    const weightRule = weight ? `font-weight: ${weight} !important;` : resetWeight ? 'font-weight: normal !important;' : '';
    const yearSelectors = resetWeight
        ? `.d${k} .text.year, .d${k} .text[style*="font-weight:bold"]`
        : `.d${k} .text.year`;
    designFontStyles += `
    <style>
        .d${k} .text, .d${k} .text.artist, .d${k} .text.name {
            font-family: ${family} !important;
            ${weightRule}
        }
        ${yearSelectors} {
            font-family: ${family} !important;
            font-weight: bold !important;
        }
    </style>`;
});
%>
<%- fontStyles %>
<%- designFontStyles %>
