<!--
    Product information pages - shared between the Reseller and Retail PDFs.
    Renders two sheets: the product itself, then ordering and options.

    Expects: baseUrl, accent, editionName
-->
<style>
    /* --- Lead ------------------------------------------------------ */
    .lead {
        font-size: 13px;
        line-height: 1.65;
        color: var(--disco);
        max-width: 168mm;
        margin-bottom: 18px;
    }

    .lead strong {
        font-weight: 700;
    }

    /* --- Streaming services: POP-outlined chips -------------------- */
    .services {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .service {
        border: 1.5px solid var(--disco);
        border-radius: 99px;
        padding: 7px 14px;
        text-align: center;
    }

    .service-name {
        font-family: var(--display);
        font-weight: 900;
        font-size: 10px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--disco);
        display: block;
    }

    .service-note {
        font-size: 7px;
        color: var(--disco-45);
        display: block;
        margin-top: 1px;
    }

    /* --- Product headline ------------------------------------------ */
    .product-lockup {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 10px;
    }

    .product-name {
        font-family: var(--display);
        font-weight: 900;
        font-size: 32px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--disco);
    }

    .product-rule {
        flex: 1;
        height: 4px;
        border-radius: 2px;
        background: var(--pop);
    }

    .product-intro {
        font-size: 12.5px;
        line-height: 1.65;
        color: var(--disco-70);
        max-width: 158mm;
        margin-bottom: 18px;
    }

    /* --- Specs: rounded POP cards ---------------------------------- */
    .specs {
        display: flex;
        gap: 9px;
    }

    .spec {
        flex: 1;
        background: var(--pop);
        border-radius: var(--radius-sm);
        padding: 12px 13px;
    }

    .spec-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--disco-70);
        margin-bottom: 4px;
    }

    .spec-value {
        font-size: 12px;
        font-weight: 700;
        color: var(--disco);
        line-height: 1.35;
    }

    /* --- Variants --------------------------------------------------- */
    .variants {
        display: flex;
        gap: 11px;
    }

    .variant {
        flex: 1;
    }

    .variant-shot {
        height: 62mm;
        border-radius: var(--radius-sm);
        overflow: hidden;
        background: var(--disco-09);
        margin-bottom: 10px;
    }

    .variant-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .variant-head {
        display: flex;
        align-items: baseline;
        gap: 7px;
        margin-bottom: 5px;
    }

    .variant-count {
        font-family: var(--display);
        font-weight: 900;
        font-size: 22px;
        letter-spacing: 0.05em;
        color: var(--disco);
    }

    .variant-unit {
        font-family: var(--display);
        font-weight: 900;
        font-size: 8px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--pop);
    }

    .variant-spec {
        font-size: 9.5px;
        font-weight: 700;
        color: var(--disco);
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .variant-copy {
        font-size: 10px;
        color: var(--disco-70);
        line-height: 1.55;
    }

    /* --- Add-ons ---------------------------------------------------- */
    .addons {
        display: flex;
        gap: 9px;
    }

    .addon {
        flex: 1;
        border: 2px solid var(--disco);
        border-radius: var(--radius-sm);
        padding: 13px 14px;
    }

    .addon-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
    }

    .addon-name {
        font-family: var(--display);
        font-weight: 900;
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--disco);
    }

    .addon-price {
        font-family: var(--display);
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--pop);
        white-space: nowrap;
    }

    .addon-copy {
        font-size: 10px;
        color: var(--disco-70);
        line-height: 1.55;
    }

    /* --- Process: POP numerals -------------------------------------- */
    .steps {
        display: flex;
        gap: 9px;
    }

    .step {
        flex: 1;
    }

    .step-num {
        font-family: var(--display);
        font-weight: 900;
        font-size: 34px;
        letter-spacing: 0.04em;
        line-height: 1;
        margin-bottom: 8px;
        color: var(--pop);
    }

    .step-title {
        font-family: var(--display);
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--disco);
        margin-bottom: 4px;
    }

    .step-copy {
        font-size: 9.5px;
        color: var(--disco-70);
        line-height: 1.5;
    }

    /* --- Choice lists ------------------------------------------------ */
    .choices {
        display: flex;
        gap: 11px;
    }

    .choice-col {
        flex: 1;
        background: var(--disco-09);
        border-radius: var(--radius-sm);
        padding: 14px 15px;
    }

    .choice-head {
        font-family: var(--display);
        font-weight: 900;
        font-size: 8.5px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--disco);
        padding-bottom: 8px;
        margin-bottom: 10px;
        border-bottom: 2px solid var(--pop);
    }

    .choice {
        display: flex;
        gap: 9px;
        margin-bottom: 11px;
    }

    .choice:last-child {
        margin-bottom: 0;
    }

    .choice-idx {
        font-family: var(--display);
        font-weight: 900;
        font-size: 10px;
        letter-spacing: 0.04em;
        color: var(--pop);
        flex-shrink: 0;
        width: 15px;
    }

    .choice-body {
        flex: 1;
    }

    .choice-name {
        font-size: 11px;
        font-weight: 700;
        color: var(--disco);
    }

    .choice-copy {
        font-size: 9.5px;
        color: var(--disco-70);
        line-height: 1.5;
    }

    /* --- Delivery banner --------------------------------------------- */
    .delivery {
        display: flex;
        align-items: center;
        gap: 0;
        background: var(--disco);
        color: var(--off);
        border-radius: var(--radius-sm);
        padding: 18px 22px;
        position: relative;
        overflow: hidden;
    }

    .delivery-note-art {
        position: absolute;
        right: 12mm;
        top: -8mm;
        width: 30mm;
        opacity: 0.85;
    }

    .delivery-note-art img {
        display: block;
        width: 100%;
        height: auto;
    }

    .delivery-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding-right: 22px;
        margin-right: 22px;
        border-right: 1px solid var(--off-20);
        position: relative;
        z-index: 2;
    }

    .delivery-item:last-child {
        border-right: none;
        margin-right: 0;
    }

    .delivery-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7px;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--pop);
    }

    .delivery-value {
        font-family: var(--display);
        font-weight: 900;
        font-size: 15px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--off);
    }
</style>

<!-- ============ SHEET: Product ============ -->
<div class="sheet">
    <div class="sheet-head">
        <img src="<%= baseUrl %>/assets/images/logo_green.png" alt="QRSong!" class="sheet-head-logo" />
        <div class="sheet-head-right">
            <div class="sheet-head-title"><%= t('productSheetTitle') %></div>
            <div class="sticker"><%= editionName %></div>
        </div>
    </div>

    <div class="sheet-body spread">
        <div class="block">
        <div class="section-title">
            <h2><%= t('howItWorks') %></h2>
                <div class="bar"></div>
        </div>

        <p class="lead">
            <strong><%= t('leadStrong') %></strong>
            <%= t('leadBody') %>
        </p>

        <div class="services">
            <div class="service"><span class="service-name">Spotify</span><span class="service-note"><%= t('serviceSpotifyNote') %></span></div>
            <div class="service"><span class="service-name">Apple Music</span><span class="service-note"><%= t('serviceAllPlans') %></span></div>
            <div class="service"><span class="service-name">YouTube Music</span><span class="service-note"><%= t('serviceAllPlans') %></span></div>
            <div class="service"><span class="service-name">Deezer</span><span class="service-note"><%= t('serviceAllPlans') %></span></div>
            <div class="service"><span class="service-name">Tidal</span><span class="service-note"><%= t('serviceAllPlans') %></span></div>
        </div>
        </div>

        <div class="block">
        <div class="product-lockup">
            <div class="product-name">QRSong! Box</div>
            <div class="product-rule"></div>
        </div>

        <p class="product-intro"><%= t('productIntro') %></p>

        <div class="specs">
            <div class="spec">
                <div class="spec-label"><%= t('specCardFormat') %></div>
                <div class="spec-value"><%- t('specCardFormatValue') %></div>
            </div>
            <div class="spec">
                <div class="spec-label"><%= t('specMaterial') %></div>
                <div class="spec-value"><%- t('specMaterialValue') %></div>
            </div>
            <div class="spec">
                <div class="spec-label"><%= t('specMinimumOrder') %></div>
                <div class="spec-value"><%= t('specMinimumOrderValue') %></div>
            </div>
            <div class="spec">
                <div class="spec-label"><%= t('specLeadTime') %></div>
                <div class="spec-value"><%= t('specLeadTimeValue') %></div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="section-title">
            <h2><%= t('threeFormats') %></h2>
                <div class="bar"></div>
        </div>

        <div class="variants">
            <div class="variant">
                <div class="variant-shot">
                    <img src="<%= baseUrl %>/assets/images/1x1.jpeg" alt="<%= t('variantAlt', { count: 48 }) %>" />
                </div>
                <div class="variant-head">
                    <span class="variant-count">48</span>
                    <span class="variant-unit"><%= t('variantCards') %></span>
                </div>
                <div class="variant-spec"><%= t('variant48Spec') %></div>
                <div class="variant-copy"><%= t('variant48Copy') %></div>
            </div>
            <div class="variant">
                <div class="variant-shot">
                    <img src="<%= baseUrl %>/assets/images/2x1.jpeg" alt="<%= t('variantAlt', { count: 96 }) %>" />
                </div>
                <div class="variant-head">
                    <span class="variant-count">96</span>
                    <span class="variant-unit"><%= t('variantCards') %></span>
                </div>
                <div class="variant-spec"><%= t('variant96Spec') %></div>
                <div class="variant-copy"><%= t('variant96Copy') %></div>
            </div>
            <div class="variant">
                <div class="variant-shot">
                    <img src="<%= baseUrl %>/assets/images/2x2.jpeg" alt="<%= t('variantAlt', { count: 192 }) %>" />
                </div>
                <div class="variant-head">
                    <span class="variant-count">192</span>
                    <span class="variant-unit"><%= t('variantCards') %></span>
                </div>
                <div class="variant-spec"><%= t('variant96Spec') %></div>
                <div class="variant-copy"><%= t('variant192Copy') %></div>
            </div>
        </div>
        </div>
    </div>

    <div class="sheet-foot">
        <div><strong>QRSong! Box</strong> &nbsp;<%= t('productFootNote') %></div>
        <div class="sheet-foot-note">www.qrsong.io</div>
    </div>
</div>

<!-- ============ SHEET: Ordering & options ============ -->
<div class="sheet">
    <div class="sheet-head">
        <img src="<%= baseUrl %>/assets/images/logo_green.png" alt="QRSong!" class="sheet-head-logo" />
        <div class="sheet-head-right">
            <div class="sheet-head-title"><%= t('orderingSheetTitle') %></div>
            <div class="sticker"><%= editionName %></div>
        </div>
    </div>

    <div class="sheet-body spread">
        <div class="block">
        <div class="section-title">
            <h2><%= t('extraOptions') %></h2>
                <div class="bar"></div>
            <div class="section-meta"><%= t('oneOffCosts') %></div>
        </div>

        <div class="addons">
            <div class="addon">
                <div class="addon-head">
                    <span class="addon-name"><%= t('addonAppName') %></span>
                    <span class="addon-price">&euro; 350</span>
                </div>
                <div class="addon-copy"><%= t('addonAppCopy') %></div>
            </div>
            <div class="addon">
                <div class="addon-head">
                    <span class="addon-name"><%= t('addonPortalName') %></span>
                    <span class="addon-price">&euro; 500</span>
                </div>
                <div class="addon-copy"><%= t('addonPortalCopy') %></div>
            </div>
            <div class="addon">
                <div class="addon-head">
                    <span class="addon-name"><%= t('addonDesignName') %></span>
                    <span class="addon-price"><%= t('addonDesignPrice') %></span>
                </div>
                <div class="addon-copy"><%= t('addonDesignCopy') %></div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="section-title">
            <h2><%= t('orderProcess') %></h2>
                <div class="bar"></div>
            <div class="section-meta"><%= t('fiveSteps') %></div>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-num">01</div>
                <div class="step-title"><%= t('step1Title') %></div>
                <div class="step-copy"><%= t('step1Copy') %></div>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <div class="step-title"><%= t('step2Title') %></div>
                <div class="step-copy"><%= t('step2Copy') %></div>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <div class="step-title"><%= t('step3Title') %></div>
                <div class="step-copy"><%= t('step3Copy') %></div>
            </div>
            <div class="step">
                <div class="step-num">04</div>
                <div class="step-title"><%= t('step4Title') %></div>
                <div class="step-copy"><%= t('step4Copy') %></div>
            </div>
            <div class="step">
                <div class="step-num">05</div>
                <div class="step-title"><%= t('step5Title') %></div>
                <div class="step-copy"><%= t('step5Copy') %></div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="section-title">
            <h2><%= t('designAndPlaylist') %></h2>
                <div class="bar"></div>
            <div class="section-meta"><%= t('choosePerItem') %></div>
        </div>

        <div class="choices">
            <div class="choice-col">
                <div class="choice-head"><%= t('designOptions') %></div>
                <div class="choice">
                    <div class="choice-idx">01</div>
                    <div class="choice-body">
                        <div class="choice-name"><%= t('design1Name') %></div>
                        <div class="choice-copy"><%= t('design1Copy') %></div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">02</div>
                    <div class="choice-body">
                        <div class="choice-name"><%= t('design2Name') %></div>
                        <div class="choice-copy"><%= t('design2Copy') %></div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">03</div>
                    <div class="choice-body">
                        <div class="choice-name"><%= t('design3Name') %></div>
                        <div class="choice-copy"><%= t('design3Copy') %></div>
                    </div>
                </div>
            </div>
            <div class="choice-col">
                <div class="choice-head"><%= t('playlistOptions') %></div>
                <div class="choice">
                    <div class="choice-idx">01</div>
                    <div class="choice-body">
                        <div class="choice-name"><%= t('playlist1Name') %></div>
                        <div class="choice-copy"><%= t('playlist1Copy') %></div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">02</div>
                    <div class="choice-body">
                        <div class="choice-name"><%= t('playlist2Name') %></div>
                        <div class="choice-copy"><%= t('playlist2Copy') %></div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">03</div>
                    <div class="choice-body">
                        <div class="choice-name"><%= t('playlist3Name') %></div>
                        <div class="choice-copy"><%= t('playlist3Copy') %></div>
                    </div>
                </div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="delivery">
            <div class="delivery-note-art">
                <img src="<%= baseUrl %>/assets/images/brand/note8_pop.png" alt="" />
            </div>
            <div class="delivery-item">
                <div class="delivery-label"><%= t('specLeadTime') %></div>
                <div class="delivery-value"><%= t('specLeadTimeValue') %></div>
            </div>
            <div class="delivery-sep"></div>
            <div class="delivery-item">
                <div class="delivery-label"><%= t('specMinimumOrder') %></div>
                <div class="delivery-value"><%= t('specMinimumOrderValue') %></div>
            </div>
            <div class="delivery-sep"></div>
            <div class="delivery-item">
                <div class="delivery-label"><%= t('deliveryLabel') %></div>
                <div class="delivery-value"><%= t('deliveryValue') %></div>
            </div>
        </div>
        </div>
    </div>

    <div class="sheet-foot">
        <div><strong><%= t('orderingFootLabel') %></strong> &nbsp;zakelijk@qrsong.io</div>
        <div class="sheet-foot-note"><%= t('orderingFootNote', { percent: 21 }) %></div>
    </div>
</div>
