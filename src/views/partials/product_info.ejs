<!--
    Product information pages - shared between the Reseller and Retail PDFs.
    Renders two sheets: the product itself, then ordering and options.

    Expects: baseUrl, accent, editionName
-->
<style>
    /* --- Lead ------------------------------------------------------ */
    .lead {
        font-size: 13px;
        line-height: 1.65;
        color: var(--disco);
        max-width: 168mm;
        margin-bottom: 18px;
    }

    .lead strong {
        font-weight: 700;
    }

    /* --- Streaming services: POP-outlined chips -------------------- */
    .services {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .service {
        border: 1.5px solid var(--disco);
        border-radius: 99px;
        padding: 7px 14px;
        text-align: center;
    }

    .service-name {
        font-family: var(--display);
        font-weight: 900;
        font-size: 10px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--disco);
        display: block;
    }

    .service-note {
        font-size: 7px;
        color: var(--disco-45);
        display: block;
        margin-top: 1px;
    }

    /* --- Product headline ------------------------------------------ */
    .product-lockup {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 10px;
    }

    .product-name {
        font-family: var(--display);
        font-weight: 900;
        font-size: 32px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--disco);
    }

    .product-rule {
        flex: 1;
        height: 4px;
        border-radius: 2px;
        background: var(--pop);
    }

    .product-intro {
        font-size: 12.5px;
        line-height: 1.65;
        color: var(--disco-70);
        max-width: 158mm;
        margin-bottom: 18px;
    }

    /* --- Specs: rounded POP cards ---------------------------------- */
    .specs {
        display: flex;
        gap: 9px;
    }

    .spec {
        flex: 1;
        background: var(--pop);
        border-radius: var(--radius-sm);
        padding: 12px 13px;
    }

    .spec-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--disco-70);
        margin-bottom: 4px;
    }

    .spec-value {
        font-size: 12px;
        font-weight: 700;
        color: var(--disco);
        line-height: 1.35;
    }

    /* --- Variants --------------------------------------------------- */
    .variants {
        display: flex;
        gap: 11px;
    }

    .variant {
        flex: 1;
    }

    .variant-shot {
        height: 62mm;
        border-radius: var(--radius-sm);
        overflow: hidden;
        background: var(--disco-09);
        margin-bottom: 10px;
    }

    .variant-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .variant-head {
        display: flex;
        align-items: baseline;
        gap: 7px;
        margin-bottom: 5px;
    }

    .variant-count {
        font-family: var(--display);
        font-weight: 900;
        font-size: 22px;
        letter-spacing: 0.05em;
        color: var(--disco);
    }

    .variant-unit {
        font-family: var(--display);
        font-weight: 900;
        font-size: 8px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--pop);
    }

    .variant-spec {
        font-size: 9.5px;
        font-weight: 700;
        color: var(--disco);
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .variant-copy {
        font-size: 10px;
        color: var(--disco-70);
        line-height: 1.55;
    }

    /* --- Add-ons ---------------------------------------------------- */
    .addons {
        display: flex;
        gap: 9px;
    }

    .addon {
        flex: 1;
        border: 2px solid var(--disco);
        border-radius: var(--radius-sm);
        padding: 13px 14px;
    }

    .addon-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
    }

    .addon-name {
        font-family: var(--display);
        font-weight: 900;
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--disco);
    }

    .addon-price {
        font-family: var(--display);
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--pop);
        white-space: nowrap;
    }

    .addon-copy {
        font-size: 10px;
        color: var(--disco-70);
        line-height: 1.55;
    }

    /* --- Process: POP numerals -------------------------------------- */
    .steps {
        display: flex;
        gap: 9px;
    }

    .step {
        flex: 1;
    }

    .step-num {
        font-family: var(--display);
        font-weight: 900;
        font-size: 34px;
        letter-spacing: 0.04em;
        line-height: 1;
        margin-bottom: 8px;
        color: var(--pop);
    }

    .step-title {
        font-family: var(--display);
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--disco);
        margin-bottom: 4px;
    }

    .step-copy {
        font-size: 9.5px;
        color: var(--disco-70);
        line-height: 1.5;
    }

    /* --- Choice lists ------------------------------------------------ */
    .choices {
        display: flex;
        gap: 11px;
    }

    .choice-col {
        flex: 1;
        background: var(--disco-09);
        border-radius: var(--radius-sm);
        padding: 14px 15px;
    }

    .choice-head {
        font-family: var(--display);
        font-weight: 900;
        font-size: 8.5px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--disco);
        padding-bottom: 8px;
        margin-bottom: 10px;
        border-bottom: 2px solid var(--pop);
    }

    .choice {
        display: flex;
        gap: 9px;
        margin-bottom: 11px;
    }

    .choice:last-child {
        margin-bottom: 0;
    }

    .choice-idx {
        font-family: var(--display);
        font-weight: 900;
        font-size: 10px;
        letter-spacing: 0.04em;
        color: var(--pop);
        flex-shrink: 0;
        width: 15px;
    }

    .choice-body {
        flex: 1;
    }

    .choice-name {
        font-size: 11px;
        font-weight: 700;
        color: var(--disco);
    }

    .choice-copy {
        font-size: 9.5px;
        color: var(--disco-70);
        line-height: 1.5;
    }

    /* --- Delivery banner --------------------------------------------- */
    .delivery {
        display: flex;
        align-items: center;
        gap: 0;
        background: var(--disco);
        color: var(--off);
        border-radius: var(--radius-sm);
        padding: 18px 22px;
        position: relative;
        overflow: hidden;
    }

    .delivery-note-art {
        position: absolute;
        right: 12mm;
        top: -8mm;
        width: 30mm;
        opacity: 0.85;
    }

    .delivery-note-art img {
        display: block;
        width: 100%;
        height: auto;
    }

    .delivery-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
        padding-right: 22px;
        margin-right: 22px;
        border-right: 1px solid var(--off-20);
        position: relative;
        z-index: 2;
    }

    .delivery-item:last-child {
        border-right: none;
        margin-right: 0;
    }

    .delivery-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 7px;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--pop);
    }

    .delivery-value {
        font-family: var(--display);
        font-weight: 900;
        font-size: 15px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--off);
    }
</style>

<!-- ============ SHEET: Product ============ -->
<div class="sheet">
    <div class="sheet-head">
        <img src="<%= baseUrl %>/assets/images/logo_green.png" alt="QRSong!" class="sheet-head-logo" />
        <div class="sheet-head-right">
            <div class="sheet-head-title">Het product</div>
            <div class="sticker"><%= editionName %></div>
        </div>
    </div>

    <div class="sheet-body spread">
        <div class="block">
        <div class="section-title">
            <h2>Hoe werkt het</h2>
                <div class="bar"></div>
        </div>

        <p class="lead">
            <strong>QRSong! is een persoonlijk muziekspel met QR-muziekkaarten.</strong>
            Scan met de gratis QRSong! app, speel het muziekfragment af en raad samen het nummer.
            De muziek speelt verborgen binnen de app, via het bestaande muziekabonnement van de
            speler. Wij ondersteunen alle populaire streamingdiensten.
        </p>

        <div class="services">
            <div class="service"><span class="service-name">Spotify</span><span class="service-note">Premium &amp; Free</span></div>
            <div class="service"><span class="service-name">Apple Music</span><span class="service-note">Alle abonnementen</span></div>
            <div class="service"><span class="service-name">YouTube Music</span><span class="service-note">Alle abonnementen</span></div>
            <div class="service"><span class="service-name">Deezer</span><span class="service-note">Alle abonnementen</span></div>
            <div class="service"><span class="service-name">Tidal</span><span class="service-note">Alle abonnementen</span></div>
        </div>
        </div>

        <div class="block">
        <div class="product-lockup">
            <div class="product-name">QRSong! Box</div>
            <div class="product-rule"></div>
        </div>

        <p class="product-intro">
            Verkrijgbaar in drie formaten, van compact geschenkje tot volledig spel.
            Alle varianten zijn volledig te bedrukken in uw huisstijl.
        </p>

        <div class="specs">
            <div class="spec">
                <div class="spec-label">Kaartformaat</div>
                <div class="spec-value">56 x 56 mm<br>afgeronde hoeken</div>
            </div>
            <div class="spec">
                <div class="spec-label">Materiaal</div>
                <div class="spec-value">350 grams karton<br>met glanslaminaat</div>
            </div>
            <div class="spec">
                <div class="spec-label">Minimale afname</div>
                <div class="spec-value">100 boxen</div>
            </div>
            <div class="spec">
                <div class="spec-label">Levertijd</div>
                <div class="spec-value">Circa 3 weken</div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="section-title">
            <h2>Drie formaten</h2>
                <div class="bar"></div>
        </div>

        <div class="variants">
            <div class="variant">
                <div class="variant-shot">
                    <img src="<%= baseUrl %>/assets/images/1x1.jpeg" alt="Box met 48 kaarten" />
                </div>
                <div class="variant-head">
                    <span class="variant-count">48</span>
                    <span class="variant-unit">kaarten</span>
                </div>
                <div class="variant-spec">Gelamineerde doos met zijklepje</div>
                <div class="variant-copy">Compact en betaalbaar. Ideaal als bedankje, relatiegeschenk of voor de Dag van de Zorg.</div>
            </div>
            <div class="variant">
                <div class="variant-shot">
                    <img src="<%= baseUrl %>/assets/images/2x1.jpeg" alt="Box met 96 kaarten" />
                </div>
                <div class="variant-head">
                    <span class="variant-count">96</span>
                    <span class="variant-unit">kaarten</span>
                </div>
                <div class="variant-spec">Stevig SK2 karton, binnen en buiten bedrukbaar</div>
                <div class="variant-copy">2 x 48 in banderol, 2-vaks doos met los dekseltje. De populaire tussenweg.</div>
            </div>
            <div class="variant">
                <div class="variant-shot">
                    <img src="<%= baseUrl %>/assets/images/2x2.jpeg" alt="Box met 192 kaarten" />
                </div>
                <div class="variant-head">
                    <span class="variant-count">192</span>
                    <span class="variant-unit">kaarten</span>
                </div>
                <div class="variant-spec">Stevig SK2 karton, binnen en buiten bedrukbaar</div>
                <div class="variant-copy">4 x 48 in banderol, 4-vaks doos met los dekseltje. Vergelijkbaar met winkelspellen.</div>
            </div>
        </div>
        </div>
    </div>

    <div class="sheet-foot">
        <div><strong>QRSong! Box</strong> &nbsp;Het muzikale cadeau dat echt van jullie is.</div>
        <div class="sheet-foot-note">www.qrsong.io</div>
    </div>
</div>

<!-- ============ SHEET: Ordering & options ============ -->
<div class="sheet">
    <div class="sheet-head">
        <img src="<%= baseUrl %>/assets/images/logo_green.png" alt="QRSong!" class="sheet-head-logo" />
        <div class="sheet-head-right">
            <div class="sheet-head-title">Bestellen &amp; opties</div>
            <div class="sticker"><%= editionName %></div>
        </div>
    </div>

    <div class="sheet-body spread">
        <div class="block">
        <div class="section-title">
            <h2>Extra opties</h2>
                <div class="bar"></div>
            <div class="section-meta">Eenmalige kosten</div>
        </div>

        <div class="addons">
            <div class="addon">
                <div class="addon-head">
                    <span class="addon-name">Eigen app</span>
                    <span class="addon-price">&euro; 350</span>
                </div>
                <div class="addon-copy">De scan-ervaring volledig in uw huisstijl. Uw logo en kleuren bij het afspelen van de muziek.</div>
            </div>
            <div class="addon">
                <div class="addon-head">
                    <span class="addon-name">Stemportaal</span>
                    <span class="addon-price">&euro; 500</span>
                </div>
                <div class="addon-copy">Laat medewerkers stemmen op hun favoriete nummers. Volledig branded in uw huisstijl.</div>
            </div>
            <div class="addon">
                <div class="addon-head">
                    <span class="addon-name">Design service</span>
                    <span class="addon-price">Op offerte</span>
                </div>
                <div class="addon-copy">Onze designers maken een uniek ontwerp voor uw box en kaarten.</div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="section-title">
            <h2>Bestelproces</h2>
                <div class="bar"></div>
            <div class="section-meta">Vijf stappen</div>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-num">01</div>
                <div class="step-title">Offerte</div>
                <div class="step-copy">Vraag vrijblijvend een offerte aan via onze website.</div>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <div class="step-title">Aanleveren</div>
                <div class="step-copy">Lever artwork en playlist aan, of kies een standaard set.</div>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <div class="step-title">Proofing</div>
                <div class="step-copy">U ontvangt een digitale proof ter goedkeuring.</div>
            </div>
            <div class="step">
                <div class="step-num">04</div>
                <div class="step-title">Productie</div>
                <div class="step-copy">Na uw goedkeuring start de productie.</div>
            </div>
            <div class="step">
                <div class="step-num">05</div>
                <div class="step-title">Levering</div>
                <div class="step-copy">Bezorging op locatie, op het afgesproken moment.</div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="section-title">
            <h2>Design &amp; playlist</h2>
                <div class="bar"></div>
            <div class="section-meta">U kiest per onderdeel</div>
        </div>

        <div class="choices">
            <div class="choice-col">
                <div class="choice-head">Design opties</div>
                <div class="choice">
                    <div class="choice-idx">01</div>
                    <div class="choice-body">
                        <div class="choice-name">Eigen design aanleveren</div>
                        <div class="choice-copy">Lever uw artwork aan volgens onze technische specificaties: PDF voor dozen, PSD voor kaarten.</div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">02</div>
                    <div class="choice-body">
                        <div class="choice-name">Onze designers</div>
                        <div class="choice-copy">Wij maken een uniek ontwerp voor u. Meerprijs op offertebasis.</div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">03</div>
                    <div class="choice-body">
                        <div class="choice-name">Standaard design</div>
                        <div class="choice-copy">Kies ons neutrale standaard ontwerp, zonder branding.</div>
                    </div>
                </div>
            </div>
            <div class="choice-col">
                <div class="choice-head">Playlist opties</div>
                <div class="choice">
                    <div class="choice-idx">01</div>
                    <div class="choice-body">
                        <div class="choice-name">Eigen playlist</div>
                        <div class="choice-copy">Lever een Spotify playlist link aan met uw gekozen nummers.</div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">02</div>
                    <div class="choice-body">
                        <div class="choice-name">Stemportaal</div>
                        <div class="choice-copy">Laat medewerkers stemmen op hun favoriete nummers. Meerprijs.</div>
                    </div>
                </div>
                <div class="choice">
                    <div class="choice-idx">03</div>
                    <div class="choice-body">
                        <div class="choice-name">Thema-playlists</div>
                        <div class="choice-copy">Kies uit honderden kant-en-klare playlists met diverse thema's.</div>
                    </div>
                </div>
            </div>
        </div>

        </div>

        <div class="block">
        <div class="delivery">
            <div class="delivery-note-art">
                <img src="<%= baseUrl %>/assets/images/brand/note8_pop.png" alt="" />
            </div>
            <div class="delivery-item">
                <div class="delivery-label">Levertijd</div>
                <div class="delivery-value">Circa 3 weken</div>
            </div>
            <div class="delivery-sep"></div>
            <div class="delivery-item">
                <div class="delivery-label">Minimale afname</div>
                <div class="delivery-value">100 boxen</div>
            </div>
            <div class="delivery-sep"></div>
            <div class="delivery-item">
                <div class="delivery-label">Levering</div>
                <div class="delivery-value">Op locatie</div>
            </div>
        </div>
        </div>
    </div>

    <div class="sheet-foot">
        <div><strong>Bestellen</strong> &nbsp;zakelijk@qrsong.io</div>
        <div class="sheet-foot-note">Prijzen excl. 21% BTW</div>
    </div>
</div>
