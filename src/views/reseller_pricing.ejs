<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>Informatie &amp; Prijzen (Resellers) - <%= formatDate(new Date()) %></title>

    <%
        // Both editions share the brand palette; only the sticker label differs.
        var editionName = 'Reseller editie';
    %>

    <%- include('partials/pricing_theme', { baseUrl: baseUrl }) %>

    <style>
        /* Reseller-only: three figures stacked inside one price cell.
           Rows are tighter than the retail edition so 14 tiers still fit
           on a single A4 sheet. */
        .pricing-table td {
            padding: 8px 12px;
        }

        .pricing-table td.price-cell {
            font-family: var(--body);
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 0;
            padding: 6px 12px;
        }

        .price-stack {
            width: 100%;
            border-collapse: collapse;
        }

        .price-stack td {
            padding: 0;
            border: none;
            line-height: 1.25;
        }

        .price-stack .stack-label {
            text-align: left;
            font-family: var(--display);
            font-weight: 900;
            font-size: 7px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--disco-45);
            width: 40px;
        }

        .price-stack .stack-value {
            text-align: right;
            font-family: var(--display);
            font-weight: 900;
            font-size: 12px;
            letter-spacing: 0.03em;
        }

        .price-stack .stack-pct {
            text-align: right;
            width: 42px;
            font-family: var(--body);
            font-size: 8px;
            font-weight: 600;
            color: var(--disco-45);
        }

        .row-buy .stack-value { color: var(--disco); }
        .row-rrp .stack-value { color: var(--disco-70); }
        .row-margin .stack-value { color: var(--pop); }
    </style>
</head>
<body>

    <%- include('partials/front_page', {
        baseUrl: baseUrl,
        formatDate: formatDate,
        title: 'Informatie & Prijzen',
        subtitle: 'Voor resellers',
        editionName: editionName,
        version: version
    }) %>

    <%- include('partials/product_info', {
        baseUrl: baseUrl,
        editionName: editionName
    }) %>

    <!-- Pricing sheet -->
    <% const boxGroup = groups.find(g => g.name === 'QRSong! Box'); %>
    <% if (boxGroup) { %>
    <div class="sheet">
        <div class="sheet-head">
            <img src="<%= baseUrl %>/assets/images/logo_green.png" alt="QRSong!" class="sheet-head-logo" />
            <div class="sheet-head-right">
                <div class="sheet-head-title">QRSong! Box</div>
                <div class="sticker"><%= editionName %></div>
            </div>
        </div>

        <div class="sheet-body">
            <div class="section-title">
                <h2>Inkoop, advies &amp; opslag</h2>
                <div class="bar"></div>
                <div class="section-meta">Per box, excl. 21% BTW</div>
            </div>

            <div class="price-panel">
                <table class="pricing-table">
                    <thead>
                        <tr>
                            <th class="qty-header">Aantal</th>
                            <% boxGroup.products.forEach((product) => { %>
                            <th>
                                <span class="col-name"><%= product.name %></span>
                                <span class="col-sub">per box</span>
                            </th>
                            <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% quantities.forEach((qty) => { %>
                        <tr>
                            <td class="qty-cell">
                                <%= formatNumber(qty) %>
                                <span class="qty-unit">boxen</span>
                            </td>
                            <% boxGroup.products.forEach((product) => {
                                const priceData = prices[product.id]?.[qty];
                            %>
                            <td class="price-cell<%= priceData ? '' : ' price-empty' %>">
                                <% if (priceData) { %>
                                <% const margin = priceData.retailPrice - priceData.resellerPrice; %>
                                <% const marginPercent = priceData.resellerPrice > 0 ? ((margin / priceData.resellerPrice) * 100).toFixed(1) : '0.0'; %>
                                <table class="price-stack">
                                    <tr class="row-buy">
                                        <td class="stack-label">Inkoop</td>
                                        <td class="stack-value"><%= formatCurrency(priceData.resellerPrice) %></td>
                                        <td class="stack-pct"></td>
                                    </tr>
                                    <tr class="row-rrp">
                                        <td class="stack-label">Advies</td>
                                        <td class="stack-value"><%= formatCurrency(priceData.retailPrice) %></td>
                                        <td class="stack-pct"></td>
                                    </tr>
                                    <tr class="row-margin">
                                        <td class="stack-label">Opslag</td>
                                        <td class="stack-value"><%= formatCurrency(margin) %></td>
                                        <td class="stack-pct"><%= marginPercent %>%</td>
                                    </tr>
                                </table>
                                <% } else { %>
                                -
                                <% } %>
                            </td>
                            <% }); %>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="sheet-foot">
            <div class="legend">
                <span class="legend-item"><span class="legend-key" style="background: var(--disco);"></span> Inkoop</span>
                <span class="legend-item"><span class="legend-key" style="background: var(--disco-45);"></span> Advies</span>
                <span class="legend-item"><span class="legend-key" style="background: var(--pop);"></span> Opslag</span>
            </div>
            <div class="sheet-foot-note">Prijzen onder voorbehoud van wijzigingen. Druk- en zetfouten voorbehouden.</div>
        </div>
    </div>
    <% } %>

    <%- include('partials/closing_page', {
        baseUrl: baseUrl,
        editionName: editionName
    }) %>

</body>
</html>
