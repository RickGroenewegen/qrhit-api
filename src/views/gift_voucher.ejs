<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>QRSong! gift voucher</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,800;125,900&family=Inter:wght@400;600;700&family=Patrick+Hand&family=Fira+Code:wght@500&display=swap" rel="stylesheet">
    <style>
        @page { size: A5 portrait; margin: 0; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; font-family: 'Inter', sans-serif; background: #fff8f3; color: #18565e; }
        .page { width: 148mm; height: 210mm; position: relative; overflow: hidden; background: #fff8f3; }
        .band { position: absolute; left: 0; right: 0; top: 0; height: 74mm; background: #18565e; }
        .band::after { content: ''; position: absolute; left: 0; right: 0; bottom: -10mm; height: 20mm; background: #18565e; border-radius: 0 0 50% 50% / 0 0 100% 100%; }
        .top { position: relative; z-index: 1; padding: 9mm 10mm 0; color: #fff8f3; }
        .logo { height: 9mm; display: block; }
        .tagline { margin-top: 2mm; font-size: 9pt; opacity: .85; }
        .title { margin: 7mm 0 0; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 900; font-size: 20pt; line-height: 1.05; letter-spacing: .01em; text-transform: uppercase; color: #fff8f3; }
        .from { margin-top: 2mm; font-family: 'Patrick Hand', cursive; font-size: 15pt; color: #f79677; }
        .cards { position: relative; z-index: 2; height: 52mm; margin-top: 4mm; display: flex; justify-content: center; align-items: center; }
        .card { width: 44mm; height: 44mm; border-radius: 3.4mm; background: #fff; border: .6mm solid #0b2c31; box-shadow: 1.4mm 1.4mm 0 #0b2c31; object-fit: cover; }
        .cover { border-radius: 2mm; }
        .cards .card + .card { margin-left: -14mm; }
        .cards .card:nth-child(1) { transform: rotate(-6deg); }
        .cards .card:nth-child(2) { transform: rotate(3deg) translateY(-2mm); }
        .cards .card:nth-child(3) { transform: rotate(9deg); }
        .cards .single { transform: rotate(-3deg); }
        .body { position: relative; padding: 4mm 10mm 0; }
        .sets { margin: 0; padding: 0; list-style: none; text-align: center; font-weight: 700; font-size: 10.5pt; color: #0b2c31; }
        .sets li + li { margin-top: 1mm; }
        .message { margin: 4mm auto 0; max-width: 112mm; padding: 3.5mm 5mm; background: #fff; border: .5mm solid #18565e; border-radius: 4mm; box-shadow: 1mm 1mm 0 #18565e; font-family: 'Patrick Hand', cursive; font-size: 13pt; line-height: 1.3; color: #0b2c31; white-space: pre-line; text-align: center; }
        .redeem { position: absolute; left: 10mm; right: 10mm; bottom: 10mm; display: flex; gap: 6mm; align-items: center; }
        .qr { width: 30mm; height: 30mm; flex: none; border-radius: 2.5mm; overflow: hidden; border: .5mm solid #18565e; background: #fff; }
        .qr svg { width: 100%; height: 100%; display: block; }
        .steps h3 { margin: 0 0 1.5mm; font-family: 'Archivo', 'Arial Black', Arial, sans-serif; font-stretch: expanded; font-weight: 800; font-size: 9pt; letter-spacing: .04em; text-transform: uppercase; color: #0b2c31; }
        .steps ol { margin: 0; padding-left: 4.5mm; font-size: 8.5pt; line-height: 1.45; }
        .code { margin-top: 2.5mm; display: inline-block; padding: 1.2mm 3mm; border: .5mm solid #18565e; border-radius: 2.5mm; background: #fff; font-size: 8pt; color: #3d6d74; }
        .code b { font-family: 'Fira Code', monospace; font-size: 10.5pt; color: #0b2c31; letter-spacing: .03em; }
        .works { margin-top: 1.8mm; font-size: 8pt; font-weight: 600; color: #3d6d74; }
    </style>
</head>
<body>
    <div class="page">
        <div class="band"></div>
        <div class="top">
            <img src="<%= process.env['API_URI'] %>/assets/images/logo_white.png" alt="QRSong!" class="logo">
            <div class="tagline"><%= translations.tagline %></div>
            <h1 class="title"><%- t('title', { name: voucher.recipientName }) %></h1>
            <div class="from"><%- t('from', { from: voucher.giverName }) %></div>
        </div>
        <div class="cards">
            <% const shown = sets.slice(0, 3); %>
            <% shown.forEach(function (set) { %>
                <% if (set.picture.src) { %>
                    <img class="card <%= set.picture.card ? '' : 'cover' %> <%= shown.length === 1 ? 'single' : '' %>" src="<%= set.picture.src %>" alt="">
                <% } else { %>
                    <div class="card <%= shown.length === 1 ? 'single' : '' %>"></div>
                <% } %>
            <% }) %>
        </div>
        <div class="body">
            <ul class="sets">
                <% sets.forEach(function (set) { %>
                    <li><%- t('set', { count: set.numberOfTracks, playlist: set.name }) %></li>
                <% }) %>
            </ul>
            <% if (voucher.message) { %>
                <% const size = voucher.message.length > 200 ? '10.5pt' : voucher.message.length > 120 ? '11.5pt' : '13pt'; %>
                <div class="message" style="font-size: <%= size %>"><%= voucher.message %></div>
            <% } %>
        </div>
        <div class="redeem">
            <div class="qr"><%- qr %></div>
            <div class="steps">
                <h3><%= translations.stepsTitle %></h3>
                <ol>
                    <li><%- t('step1', { url: redeemHost }) %></li>
                    <li><%= translations.step2 %></li>
                    <li><%= translations.step3 %></li>
                </ol>
                <div class="code"><%= translations.codeLabel %>: <b><%= code %></b></div>
                <% if (hasPrinted) { %>
                    <div class="works"><%= translations.cardsWork %></div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
