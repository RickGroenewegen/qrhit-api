<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title><%= t('title') %> - <%= company.name %></title>
    <style>
        @media print {
            @page {
                size: A4;
                margin: 0;
            }
            body {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.5;
            color: #333;
            background: white;
            font-size: 14px;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 210mm;
            height: 297mm;
            margin: 0 auto;
            padding: 12mm 15mm;
            box-sizing: border-box;
            background: white;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
        }

        /* Header Section */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
            padding-bottom: 10px;
        }

        .quotation-title {
            font-size: 42px;
            color: #5FBFFF;
            font-weight: 300;
            letter-spacing: -1px;
        }

        .company-section {
            text-align: right;
        }

        .company-section .label {
            font-size: 10px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .logo {
            height: 50px;
            width: auto;
            margin-bottom: 8px;
        }

        .company-details {
            font-size: 11px;
            color: #666;
            line-height: 1.3;
            text-align: right;
        }

        /* Contact and Details Section */
        .info-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            margin-bottom: 15px;
        }

        .info-box {
            position: relative;
        }

        .info-label {
            font-size: 11px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            padding-left: 15px;
            position: relative;
        }

        .info-label:before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 4px;
            height: 15px;
            background: #5FBFFF;
        }

        .info-content {
            padding-left: 15px;
        }

        .info-content .name {
            font-size: 15px;
            font-weight: 600;
            color: #333;
            margin-bottom: 4px;
        }

        .info-content .details {
            font-size: 12px;
            color: #666;
            line-height: 1.4;
        }

        .info-field {
            margin-top: 4px;
            display: flex;
            gap: 12px;
        }

        .info-field .field-label {
            font-weight: 600;
            color: #333;
            min-width: 60px;
            display: inline-block;
        }

        /* Quotation Details Box */
        .quotation-details {
            background: #f9f9f9;
            padding: 12px 15px;
            border-radius: 4px;
        }

        .quotation-details .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 13px;
        }

        .quotation-details .detail-label {
            color: #666;
        }

        .quotation-details .detail-value {
            color: #333;
            font-weight: 600;
        }

        /* Table Section */
        .table-container {
            margin-bottom: 12px;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        thead {
            background: #5FBFFF;
            color: white;
        }

        thead th {
            padding: 8px 15px;
            text-align: left;
            font-weight: 500;
            font-size: 13px;
            white-space: nowrap;
        }

        thead th:first-child {
            border-top-left-radius: 4px;
            border-bottom-left-radius: 4px;
        }

        thead th:nth-child(2),
        thead th:nth-child(3),
        thead th:nth-child(4) {
            text-align: right;
        }

        thead th:last-child {
            border-top-right-radius: 4px;
            border-bottom-right-radius: 4px;
        }

        tbody tr {
            border-bottom: 1px solid #f0f0f0;
        }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody td {
            padding: 8px 15px;
            font-size: 13px;
            color: #333;
        }

        tbody td:nth-child(2) {
            text-align: right;
        }

        tbody td:nth-child(3),
        tbody td:nth-child(4) {
            text-align: right;
            font-weight: 600;
            white-space: nowrap;
        }

        .item-description {
            color: #333;
        }

        .item-details {
            display: block;
            font-size: 11px;
            color: #999;
            margin-top: 4px;
        }

        /* Totals Section */
        .totals-container {
            margin-top: -1px;
            margin-bottom: 15px;
        }

        .totals-table {
            width: 100%;
            margin-top: -1px;
        }

        .totals-table td {
            padding: 4px 15px;
            font-size: 13px;
        }

        .totals-table td:last-child {
            text-align: right;
            font-weight: 600;
            white-space: nowrap;
            width: 17.5%;
        }

        .totals-table td:first-child {
            text-align: right;
            padding-right: 20px;
            color: #666;
        }

        .total-row.subtotal td {
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 10px;
            font-size: 13px;
        }

        .total-row.grand-total td {
            padding-top: 10px;
            border-top: 2px solid #5FBFFF;
            font-weight: 600;
            font-size: 13px;
        }

        .total-row.vat td {
            color: #666;
            font-style: italic;
            font-size: 13px;
        }

        .total-row.vat td:last-child {
            font-weight: 600;
            font-style: normal;
            text-align: right;
        }

        .total-row.grand-total-incl td {
            padding-top: 8px;
            border-top: 2px solid #5FBFFF;
            font-size: 16px;
            font-weight: bold;
        }

        .total-row.grand-total-incl td:last-child {
            color: #5FBFFF;
            font-size: 18px;
        }

        /* Terms Section */
        .terms-section {
            margin-bottom: 25px;
            page-break-before: always;
            padding-top: 15mm; /* Match container padding for proper page 2 top margin */
        }

        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #333;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #5FBFFF;
            display: inline-block;
        }

        .terms-list {
            list-style: none;
            padding: 0;
        }

        .terms-list li {
            position: relative;
            padding-left: 25px;
            margin-bottom: 10px;
            font-size: 13px;
            color: #666;
            line-height: 1.6;
        }

        .terms-list li:before {
            content: counter(item) ".";
            counter-increment: item;
            position: absolute;
            left: 0;
            color: #5FBFFF;
            font-weight: 600;
        }

        .terms-list {
            counter-reset: item;
        }

        /* Notes Section */
        .notes-section {
            margin-bottom: 40px;
            page-break-before: always;
            padding-top: 15mm;
        }

        .notes-content {
            font-size: 13px;
            color: #666;
            line-height: 1.8;
            background: #f9f9f9;
            padding: 20px;
            border-radius: 4px;
            border-left: 4px solid #5FBFFF;
        }

        /* Footer */
        .footer {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
        }

        .footer-content {
            font-size: 13px;
            color: #666;
            line-height: 1.6;
        }

        .footer-content strong {
            color: #333;
        }

        .footer-content a {
            color: #5FBFFF;
            text-decoration: none;
        }

    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div>
                <h1 class="quotation-title"><%= t('title') %></h1>
            </div>
            <div class="company-section">
                <div class="label"><%= t('issuedBy') %></div>
                <img src="<%= baseUrl %>/assets/images/logo.png" alt="QRSong!" class="logo" />
                <div class="company-details">
                    QRSong!<br>
                    Box A3821<br>
                    Keurenplein 41<br>
                    1069CD Amsterdam<br>
                    zakelijk@qrsong.io<br>
                    <%= t('senderCoc') %>: 99311917<br>
                    <%= t('senderVat') %>: <%= locale === 'nl' ? '8689.27.764.B.01' : 'NL868927764B01' %>
                </div>
            </div>
        </div>

        <!-- Contact Info and Quote Details -->
        <div class="info-section">
            <div class="info-box">
                <div class="info-label"><%= t('addressedTo') %></div>
                <div class="info-content">
                    <div class="name"><%= company.name %></div>
                    <div class="details">
                        <% if (company.address && company.housenumber) { %>
                            <%= company.address %> <%= company.housenumber %><br>
                        <% } %>
                        <% if (company.zipcode && company.city) { %>
                            <%= company.zipcode %> <%= company.city %><br>
                        <% } %>
                        <% if (company.countrycode) { %>
                            <%= company.countrycode %><br>
                        <% } %>

                        <% if (company.contact) { %>
                            <div class="info-field">
                                <span class="field-label"><%= t('labelContact') %></span>
                                <span><%= company.contact %></span>
                            </div>
                        <% } %>
                        <% if (company.contactphone) { %>
                            <div class="info-field">
                                <span class="field-label"><%= t('labelPhone') %></span>
                                <span><%= company.contactphone %></span>
                            </div>
                        <% } %>
                        <% if (company.contactemail) { %>
                            <div class="info-field">
                                <span class="field-label"><%= t('labelEmail') %></span>
                                <span><%= company.contactemail %></span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="info-box">
                <div class="info-label"><%= t('detailsTitle') %></div>
                <div class="quotation-details">
                    <div class="detail-row">
                        <span class="detail-label"><%= t('number') %></span>
                        <span class="detail-value"><%= quotationNumber %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label"><%= t('date') %></span>
                        <span class="detail-value"><%= formatDate(new Date()) %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label"><%= t('validUntil') %></span>
                        <span class="detail-value"><%= formatDate(validUntil) %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th style="width: 50%"><%= t('thDescription') %></th>
                        <th style="width: 15%"><%= t('thQuantity') %></th>
                        <th style="width: 17.5%"><%= t('thUnitPrice') %></th>
                        <th style="width: 17.5%"><%= t('thAmount') %></th>
                    </tr>
                </thead>
                <tbody>
                    <%
                        // Determine the price per unit to use
                        const pricePerUnit = calculatedPrices && calculatedPrices.clientPricePerUnit
                            ? calculatedPrices.clientPricePerUnit
                            : calculationResult.pricePerSet;
                        const quantity = calculationResult.quantity;
                        const lineTotal = pricePerUnit * quantity;
                    %>
                    <!-- Main product line -->
                    <tr>
                        <td>
                            <span class="item-description"><%= productDescription || t('productCardSet') %></span>
                            <span class="item-details">
                                <%= productDetails || t('productStandardBoxDetails') %>
                            </span>
                        </td>
                        <td><%= quantity %></td>
                        <td><%= formatCurrency(pricePerUnit) %></td>
                        <td><%= formatCurrency(lineTotal) %></td>
                    </tr>

                    <!-- Extras (filter out custom app and voting portal as they're shown separately) -->
                    <% if (calculationResult.extras && calculationResult.extras.length > 0) { %>
                        <%# App and voting portal have their own rows below, so they are
                            filtered out here by key rather than by matching Dutch text. %>
                        <% calculationResult.extras.filter(extra => extra.key !== 'customApp' && extra.key !== 'votingPortal').forEach(function(extra) { %>
                        <tr>
                            <td>
                                <span class="item-description"><%= extra.key ? tExtra(extra.key, extra.keyVars) : extra.name %></span>
                                <span class="item-details"><%= t('itemOneOff') %></span>
                            </td>
                            <td>1</td>
                            <td><%= formatCurrency(extra.price) %></td>
                            <td><%= formatCurrency(extra.price) %></td>
                        </tr>
                        <% }); %>
                    <% } %>
                    <% if (calculationResult.customAppFee > 0) { %>
                    <tr>
                        <td>
                            <span class="item-description"><%= t('itemCustomApp') %></span>
                            <span class="item-details"><%= t('itemCustomAppDetails') %></span>
                        </td>
                        <td>1</td>
                        <td><%= formatCurrency(350) %></td>
                        <td><%= formatCurrency(350) %></td>
                    </tr>
                    <% } %>
                    <% if (calculationResult.votingPortalFee > 0) { %>
                    <tr>
                        <td>
                            <span class="item-description"><%= t('itemVotingPortal') %></span>
                            <span class="item-details"><%= t('itemVotingPortalDetails') %></span>
                        </td>
                        <td>1</td>
                        <td><%= formatCurrency(500) %></td>
                        <td><%= formatCurrency(500) %></td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <%
            // Calculate subtotal from line items - use calculatedPrices when available
            const mainProductTotal = calculatedPrices && calculatedPrices.clientPricePerUnit
                ? calculatedPrices.clientPricePerUnit * calculationResult.quantity
                : calculationResult.pricePerSet * calculationResult.quantity;
            // Filter out app and voting portal from extras to avoid double counting (they're shown separately)
            const extrasTotal = calculationResult.extras && calculationResult.extras.length > 0
                ? calculationResult.extras.filter(extra => extra.key !== 'customApp' && extra.key !== 'votingPortal').reduce((sum, extra) => sum + extra.price, 0)
                : 0;
            const customAppFeeTotal = calculationResult.customAppFee || 0;
            const votingPortalFeeTotal = calculationResult.votingPortalFee || 0;
            const subtotal = mainProductTotal + extrasTotal + customAppFeeTotal + votingPortalFeeTotal;

            // Apply manual discount percentage
            const manualDiscountPct = calculation.manualDiscountPercent || 0;
            const discountAmount = subtotal * (manualDiscountPct / 100);
            const totalAfterDiscount = subtotal - discountAmount;

            const vatCtx = (typeof vatContext !== 'undefined' && vatContext) ? vatContext : { region: 'nl', rate: 21, reverseCharge: false };
            const vat = Math.round(totalAfterDiscount * (vatCtx.rate / 100) * 100) / 100; // Round VAT to 2 decimals
            const totalInclVat = totalAfterDiscount + vat; // Add rounded VAT to subtotal
        %>
        <div class="totals-container">
            <table class="totals-table">
                <tr class="total-row subtotal">
                    <td colspan="3"><%= t('subtotal') %></td>
                    <td><%= formatCurrency(subtotal) %></td>
                </tr>

                <% if (manualDiscountPct > 0) { %>
                <tr class="total-row discount">
                    <td colspan="3"><%= t('discount', { percent: manualDiscountPct }) %></td>
                    <td><%= formatCurrency(-(discountAmount)) %></td>
                </tr>
                <% } %>

                <tr class="total-row grand-total">
                    <td colspan="3"><%= t('totalExclVat') %></td>
                    <td><%= formatCurrency(totalAfterDiscount) %></td>
                </tr>

                <tr class="total-row vat">
                    <% if (vatCtx.reverseCharge) { %>
                    <td colspan="3"><%= t('vatReverseCharge') %></td>
                    <td><%= formatCurrency(0) %></td>
                    <% } else { %>
                    <td colspan="3"><%= t('vat', { percent: vatCtx.rate }) %></td>
                    <td><%= formatCurrency(vat) %></td>
                    <% } %>
                </tr>

                <tr class="total-row grand-total-incl">
                    <td colspan="3"><%= vatCtx.rate > 0 ? t('totalInclVat') : t('total') %></td>
                    <td><%= formatCurrency(totalInclVat) %></td>
                </tr>
            </table>
            <% if (vatCtx.reverseCharge) { %>
            <div style="text-align: right; font-size: 9px; color: #666; margin-top: 4px;">
                <%= t('vatReverseChargeNote') %>
            </div>
            <% } %>
        </div>

        <!-- Signature Section -->
        <div style="margin-top: 12px;">
            <div style="font-size: 10px; color: #666; margin-bottom: 6px; line-height: 1.4;">
                <%= t('signatureIntro') %>
            </div>
            <div style="border: 1px solid #e0e0e0; border-radius: 4px; padding: 10px; width: 50%;">
                <div style="font-size: 11px; color: #666; margin-bottom: 4px;"><%= t('signatureFor') %> <%= company.name %></div>
                <div style="border-bottom: 1px solid #ccc; height: 30px;"></div>
            </div>
        </div>

        <!-- Deposit Notice -->
        <div class="deposit-notice" style="margin-top: 10px; padding: 10px; background: #f0f8ff; border-left: 4px solid #5FBFFF; border-radius: 4px;">
            <strong style="color: #5FBFFF; font-size: 12px;"><%= t('depositTitle') %></strong>
            <p style="margin: 4px 0 0 0; font-size: 11px; color: #666; line-height: 1.3;">
                <%= t('depositText') %>
            </p>
        </div>

        <!-- Notes Section (Page 2) -->
        <div class="notes-section">
            <h2 class="section-title"><%= t('productInfoTitle') %></h2>
            <div class="notes-content">
                <% if (productType === 'schneider') { %>
                    <%
                        const cardCount = calculation.cardCount || 48;
                        const totalCards = calculationResult.quantity * cardCount;
                    %>
                    <strong><%= t('piWhatIsDelivered') %></strong><br>
                    • <%= t('piSchneiderBoxes', { quantity: calculationResult.quantity }) %><br>
                    • <%= t('piSchneiderCardsPerBox', { cards: cardCount }) %><br>
                    • <%= t('piSchneiderTotal', { boxes: calculationResult.quantity, cards: totalCards }) %><br><br>

                    <strong><%= t('piSpecsBox') %></strong><br>
                    <% if (cardCount === 48) { %>
                    • <%= t('piSchneider48a') %><br>
                    • <%= t('piSchneider48b') %><br>
                    <% } else if (cardCount === 96) { %>
                    • <%= t('piSchneider96') %><br>
                    • <%= t('piSchneiderBoard') %><br>
                    <% } else if (cardCount === 144) { %>
                    • <%= t('piSchneider144') %><br>
                    • <%= t('piSchneiderBoard') %><br>
                    <% } else { %>
                    • <%= t('piSchneiderOther') %><br>
                    • <%= t('piSchneiderBoard') %><br>
                    <% } %>
                    <br>

                    <strong><%= t('piSpecsCards') %></strong><br>
                    • <%= t('piSchneiderCard1') %><br>
                    • <%= t('piSchneiderCard2') %><br>
                    • <%= t('piSchneiderCard3') %><br>
                    • <%= t('piSchneiderCard4') %>
                <% } else { %>
                    <strong><%= t('piWhatIsDelivered') %></strong><br>
                    • <%= t('piTrompSets', { quantity: calculationResult.quantity }) %><br>
                    • <%= t('piTrompSetContains') %><br>
                    • <%= t('piTrompTotal', { boxes: calculationResult.quantity, cards: calculationResult.quantity * 200 }) %><br><br>

                    <strong><%= t('piSpecsBoxes') %></strong><br>
                    • <%= t('piTrompBox1') %><br>
                    • <%= t('piTrompBox2') %><br>
                    • <%= t('piTrompBox3') %><br>
                    • <%= t('piTrompBox4') %><br>
                    • <%= t('piTrompBox5') %><br>
                    • <%= t('piTrompBox6') %><br><br>

                    <strong><%= t('piSpecsCards') %></strong><br>
                    • <%= t('piTrompCard1') %><br>
                    • <%= t('piTrompCard2') %><br>
                    • <%= t('piTrompCard3') %><br>
                    • <%= t('piTrompCard4') %>
                <% } %>
            </div>
        </div>

        <%- include('partials/quotation_terms', { brandName: 'QRSong!' }) %>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-content">
                <%= t('footerContact') %> <a href="mailto:zakelijk@qrsong.io">zakelijk@qrsong.io</a>
            </div>
        </div>
    </div>
</body>
</html>
