# Database
DATABASE_URL=

# Redis
REDIS_URL=

# MusicFetch API
MUSICFETCH_API_KEY=

# Print&Bind REST API (https://www.printenbind.nl/api/docs)
# Development: https://sandbox.printenbind.nl/api/rest with a sandbox token
# Production:  https://www.printenbind.nl/api/rest with the live token
PRINTENBIND_API_URL=
PRINTENBIND_API_KEY=
# Print&Bind legacy JSON API, selectable from the admin bulk actions as a
# fallback for the REST integration. Same token; the code appends /v1/...
# itself, so this is the bare API root, e.g. https://www.printenbind.nl/api
PRINTENBIND_V1_API_URL=

# Serper (https://serper.dev): the Google search the release-year lookup reads
# (src/yearEvidence.ts). Without it the lookup reads Wikipedia only.
SERPER_API_KEY=

# Meta Conversions API (src/metaConversions.ts): the purchase the Meta pixel
# reports, sent again from the server. The pixel (dataset) id, and an access
# token from Events Manager → the pixel → Settings → Conversions API. Without
# both nothing is sent. Outside production it only sends with a test event
# code (Events Manager → Test events), which production may also set while
# checking.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# App Store Server API (src/storeRefunds.ts): the job that finds App Store
# refunds of the scan app's orders. An In-App Purchase key from App Store
# Connect → Users and Access → Integrations → In-App Purchase: the path to
# its .p8 file, its key ID and the issuer ID shown there. Without them only
# Google Play refunds are checked.
APPLE_IAP_KEY_FILE=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=

# Add other environment variables here...